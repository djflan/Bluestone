# Repository-wide ignores. Toolchain rules live next to the code they apply to:
#   src/dotnet/.gitignore  .NET (regenerate with `dotnet new gitignore` in that folder)
#   src/native/.gitignore  Rust

# dotenv files
.env
.env.*

# Written to the current directory, which is usually the repository root
BenchmarkDotNet.Artifacts/
[Tt]est[Rr]esult*/

# VS Code: share only the workspace config
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# JetBrains
.idea/

# Vim
*.swp

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# Local agent briefing (not distributed)
AGENT_HANDOFF.md

# Yamaha XG MIDI samples (not distributed)
samples/xg/
