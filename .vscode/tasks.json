{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build desktop",
            "type": "process",
            "command": "dotnet",
            "args": ["build", "${workspaceFolder}/src/dotnet/Bluestone.Desktop/Bluestone.Desktop.csproj", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "test",
            "type": "process",
            "command": "dotnet",
            "args": ["test", "--solution", "${workspaceFolder}/src/dotnet/Bluestone.slnx"],
            "group": "test",
            "problemMatcher": "$msCompile"
        }
    ]
}
