{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Bluestone",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build desktop",
            "program": "${workspaceFolder}/src/dotnet/Bluestone.Desktop/bin/Debug/net10.0/Bluestone.Desktop.dll",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "Bluestone (demo song)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build desktop",
            "program": "${workspaceFolder}/src/dotnet/Bluestone.Desktop/bin/Debug/net10.0/Bluestone.Desktop.dll",
            "args": ["${workspaceFolder}/samples/bluestone-demo.mid"],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            // Pick Bluestone or a plugin worker (Bluestone.PluginWorker) from the list.
            "name": "Attach to a Bluestone process",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ]
}
