<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests that use real threads, clocks, file systems, or OS services. Never requires MIDI hardware. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Bluestone.Tests.Integration</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Bluestone.Application/Bluestone.Application.csproj" />
    <ProjectReference Include="../Bluestone.Audio/Bluestone.Audio.csproj" />
    <ProjectReference Include="../Bluestone.Domain/Bluestone.Domain.csproj" />
    <ProjectReference Include="../Bluestone.Infrastructure/Bluestone.Infrastructure.csproj" />
    <ProjectReference Include="../Bluestone.Midi/Bluestone.Midi.csproj" />
    <ProjectReference Include="../Bluestone.Platform.Alsa/Bluestone.Platform.Alsa.csproj" />
    <ProjectReference Include="../Bluestone.Platform.CoreMidi/Bluestone.Platform.CoreMidi.csproj" />
    <ProjectReference Include="../Bluestone.Platform.Windows/Bluestone.Platform.Windows.csproj" />
    <ProjectReference Include="../Bluestone.Playback/Bluestone.Playback.csproj" />
    <ProjectReference Include="../Bluestone.Plugins/Bluestone.Plugins.csproj" />
    <ProjectReference Include="../Bluestone.Plugins.Protocol/Bluestone.Plugins.Protocol.csproj" />
    <!-- Built and copied beside the tests so they can launch real worker processes; never loaded in the test process. -->
    <ProjectReference Include="../Bluestone.PluginWorker/Bluestone.PluginWorker.csproj" ReferenceOutputAssembly="false" OutputItemType="Content" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../Bluestone.Presentation/Bluestone.Presentation.csproj" />
    <ProjectReference Include="../Bluestone.Profiles/Bluestone.Profiles.csproj" />
    <ProjectReference Include="../Bluestone.Signal/Bluestone.Signal.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <!-- The Rust test plugins, packaged as a VST3 bundle and a CLAP module in test-plugins/ (ADR 0033). -->
  <ItemGroup>
    <RustCrate Include="bluestone_test_plugins" />
  </ItemGroup>
  <Import Project="../Native.targets" />
  <Import Project="../NativeTestPlugins.targets" />
</Project>
