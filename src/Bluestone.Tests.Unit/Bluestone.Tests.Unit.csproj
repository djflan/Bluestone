<Project Sdk="Microsoft.NET.Sdk">
  <!-- Fast, deterministic tests. Must never require MIDI hardware, network, or wall-clock timing. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Bluestone.Tests.Unit</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="CsCheck" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Bluestone.Application/Bluestone.Application.csproj" />
    <ProjectReference Include="../Bluestone.Audio/Bluestone.Audio.csproj" />
    <ProjectReference Include="../Bluestone.Domain/Bluestone.Domain.csproj" />
    <ProjectReference Include="../Bluestone.Infrastructure/Bluestone.Infrastructure.csproj" />
    <ProjectReference Include="../Bluestone.Midi/Bluestone.Midi.csproj" />
    <ProjectReference Include="../Bluestone.Playback/Bluestone.Playback.csproj" />
    <ProjectReference Include="../Bluestone.PluginWorker/Bluestone.PluginWorker.csproj" />
    <ProjectReference Include="../Bluestone.Plugins/Bluestone.Plugins.csproj" />
    <ProjectReference Include="../Bluestone.Plugins.Protocol/Bluestone.Plugins.Protocol.csproj" />
    <ProjectReference Include="../Bluestone.Presentation/Bluestone.Presentation.csproj" />
    <ProjectReference Include="../Bluestone.Profiles/Bluestone.Profiles.csproj" />
    <ProjectReference Include="../Bluestone.Signal/Bluestone.Signal.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Infrastructure/Fixtures/**" CopyToOutputDirectory="PreserveNewest" LinkBase="Infrastructure/Fixtures" />
  </ItemGroup>
</Project>
