<Project Sdk="Microsoft.NET.Sdk">
  <!-- Performance measurements. Run in Release; see docs/adr/0012-performance-baseline.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Bluestone.Benchmarks</RootNamespace>
    <!-- Benchmark methods must be instance members even when they touch no state (CA1822),
         and BenchmarkDotNet owns disposal of benchmark instances (CA1001). -->
    <NoWarn>$(NoWarn);CA1822;CA1001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Bluestone.Application/Bluestone.Application.csproj" />
    <ProjectReference Include="../Bluestone.Audio/Bluestone.Audio.csproj" />
    <ProjectReference Include="../Bluestone.Infrastructure/Bluestone.Infrastructure.csproj" />
    <ProjectReference Include="../Bluestone.Platform.CoreMidi/Bluestone.Platform.CoreMidi.csproj" />
    <ProjectReference Include="../Bluestone.Platform.Windows/Bluestone.Platform.Windows.csproj" />
    <ProjectReference Include="../Bluestone.Playback/Bluestone.Playback.csproj" />
    <ProjectReference Include="../Bluestone.Profiles/Bluestone.Profiles.csproj" />
  </ItemGroup>
</Project>
