    <RootNamespace>Bluestone.Engine.Protocol</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Bluestone.Tests.Unit" />
    <InternalsVisibleTo Include="Bluestone.Tests.Integration" />
  </ItemGroup>
</Project>
