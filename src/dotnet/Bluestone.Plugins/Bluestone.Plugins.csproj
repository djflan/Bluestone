       in this process. See docs/plugin-hosting.md. -->
  <PropertyGroup>
    <RootNamespace>Bluestone.Plugins</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Bluestone.Tests.Unit" />
