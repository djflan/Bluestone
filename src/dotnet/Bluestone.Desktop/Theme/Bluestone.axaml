<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Bluestone.Desktop.Controls">
  <!--
    Bluestone design system, layered on Fluent: neutral charcoal surfaces divided by hairlines (no
    floating cards), compact controls, a monochrome 16-unit icon set, and colour reserved for
    meaning (track colours, record, cycle, mute and solo).
  -->
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Bluestone.Desktop/Theme/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>

    <!-- Fluent's own sizes and radii, so combo boxes, fields, steppers, and flyouts match. -->
    <CornerRadius x:Key="ControlCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">4</CornerRadius>
    <x:Double x:Key="ControlContentThemeFontSize">12</x:Double>
    <Thickness x:Key="ComboBoxPadding">8,2,0,2</Thickness>
    <x:Double x:Key="TextControlThemeMinHeight">24</x:Double>
    <Thickness x:Key="TextControlThemePadding">6,3,6,3</Thickness>

    <!--
      Icons on a 16-unit grid. "Stroke" icons (outline style) use PathIcon.stroke; the rest are filled.
    -->
    <StreamGeometry x:Key="Icon.Play">M4.5,2.8 L13,8 L4.5,13.2 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Pause">M4,3 H6.6 V13 H4 Z M9.4,3 H12 V13 H9.4 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Stop">M3.5,3.5 H12.5 V12.5 H3.5 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Record">M8,3 A5,5 0 1 1 7.99,3 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Start">M3,3 H4.8 V13 H3 Z M13,3 L5.6,8 L13,13 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Rewind">M8,3.5 L1.8,8 L8,12.5 Z M14.2,3.5 L8,8 L14.2,12.5 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Forward">M8,3.5 L14.2,8 L8,12.5 Z M1.8,3.5 L8,8 L1.8,12.5 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Cycle">M2.5,9.5 V6.5 A2.5,2.5 0 0 1 5,4 H12.5 M10.5,2 L12.5,4 L10.5,6 M13.5,6.5 V9.5 A2.5,2.5 0 0 1 11,12 H3.5 M5.5,10 L3.5,12 L5.5,14</StreamGeometry>
    <StreamGeometry x:Key="Icon.Metronome">M4.5,13.5 L6.7,2.5 H9.3 L11.5,13.5 Z M8,10.5 L12,4 M5.4,9.5 H8.6</StreamGeometry>
    <StreamGeometry x:Key="Icon.Panic">M5.6,2 H10.4 L14,5.6 V10.4 L10.4,14 H5.6 L2,10.4 V5.6 Z M8,5 V8.6 M8,11 V11.1</StreamGeometry>
    <StreamGeometry x:Key="Icon.Undo">M6,3.5 L3,6.5 L6,9.5 M3.5,6.5 H10 A3,3 0 0 1 10,12.5 H7</StreamGeometry>
    <StreamGeometry x:Key="Icon.Redo">M10,3.5 L13,6.5 L10,9.5 M12.5,6.5 H6 A3,3 0 0 0 6,12.5 H9</StreamGeometry>
    <StreamGeometry x:Key="Icon.Inspector">M2.5,3 H13.5 V13 H2.5 Z M6.5,3 V13 M3.8,5.5 H5.2 M3.8,7.5 H5.2</StreamGeometry>
    <StreamGeometry x:Key="Icon.EditorPane">M2.5,3 H13.5 V13 H2.5 Z M2.5,8.5 H13.5 M4.5,10.5 H7 M8.5,11.2 H11.5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Arrow">M4,1.8 V13 L6.9,10.3 L8.8,14.3 L10.6,13.5 L8.7,9.6 L12.5,9.4 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Pencil">M10.5,2.5 L13.5,5.5 L5.5,13.5 H2.5 V10.5 Z M9,4 L12,7</StreamGeometry>
    <StreamGeometry x:Key="Icon.Eraser">M9.3,2.8 L13.2,6.7 L7,12.9 H4.2 L2.6,11.3 A1,1 0 0 1 2.6,9.9 Z M5.9,6.2 L9.8,10.1 M7,12.9 H13.5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Magnet">M3.5,2.5 V8 A4.5,4.5 0 0 0 12.5,8 V2.5 H10 V8 A2,2 0 0 1 6,8 V2.5 Z M3.5,5 H6 M10,5 H12.5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Piano">M2.5,3 H13.5 V13 H2.5 Z M5.2,9 V13 M8,9 V13 M10.8,9 V13 M4.6,3 V9 H5.8 V3 M7.4,3 V9 H8.6 V3 M10.2,3 V9 H11.4 V3</StreamGeometry>
    <StreamGeometry x:Key="Icon.PianoRoll">M2.5,2.5 V13.5 H13.5 M5,5 H8 M7,8 H11.5 M9.5,11 H13</StreamGeometry>
    <StreamGeometry x:Key="Icon.List">M5.5,4 H13.5 M5.5,8 H13.5 M5.5,12 H13.5 M2.5,4 H2.6 M2.5,8 H2.6 M2.5,12 H2.6</StreamGeometry>
    <StreamGeometry x:Key="Icon.Monitor">M1.5,8.5 H4.5 L6,4 L9,13 L10.5,8.5 H14.5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Messages">M2.5,3.5 H13.5 V10.5 H7 L4,13 V10.5 H2.5 Z M5,6 H11 M5,8 H9</StreamGeometry>
    <StreamGeometry x:Key="Icon.Browser">M2.5,3 H13.5 V13 H2.5 Z M9.5,3 V13 M10.8,5.5 H12.2 M10.8,7.5 H12.2 M10.8,9.5 H12.2</StreamGeometry>
    <StreamGeometry x:Key="Icon.Devices">M1.5,4.5 H5 V11.5 H1.5 Z M6.25,4.5 H9.75 V11.5 H6.25 Z M11,4.5 H14.5 V11.5 H11 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Lock">M4,7.5 H12 V13.5 H4 Z M5.5,7.5 V5.5 A2.5,2.5 0 0 1 10.5,5.5 V7.5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Unlock">M4,7.5 H12 V13.5 H4 Z M5.5,7.5 V5.5 A2.5,2.5 0 0 1 10.3,4.6</StreamGeometry>
    <StreamGeometry x:Key="Icon.Power">M8,2.5 V7.5 M5,4.3 A4.6,4.6 0 1 0 11,4.3</StreamGeometry>
    <StreamGeometry x:Key="Icon.More">M3,8 H3.2 M8,8 H8.2 M13,8 H13.2</StreamGeometry>
    <StreamGeometry x:Key="Icon.Detach">M9,2.5 H13.5 V7 M13.5,2.5 L8,8 M6.5,3.5 H2.5 V13.5 H12.5 V9.5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Collapse">M2.5,3 H13.5 V13 H2.5 Z M2.5,10 H13.5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Close">M4,4 L12,12 M12,4 L4,12</StreamGeometry>
    <StreamGeometry x:Key="Icon.Editor">M2.5,3.5 H13.5 V12.5 H2.5 Z M2.5,6 H13.5 M5,8.5 V10.5 M8,8 V10.5 M11,9 V10.5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Search">M7,3 A4,4 0 1 1 6.99,3 Z M10,10 L13.5,13.5</StreamGeometry>
    <StreamGeometry x:Key="Icon.ChevronLeft">M10,3.5 L5.5,8 L10,12.5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Save">M3,2.5 H11 L13.5,5 V13.5 H3 Z M5.5,2.5 V6 H10 V2.5 M5.5,13.5 V9.5 H10.5 V13.5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Open">M2.5,4 H6.5 L8,5.5 H13.5 V12.5 H2.5 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Plus">M8,3 V13 M3,8 H13</StreamGeometry>
    <StreamGeometry x:Key="Icon.Trash">M3,4.5 H13 M6.5,4.5 V2.8 H9.5 V4.5 M4.5,4.5 L5.2,13.2 H10.8 L11.5,4.5 M6.8,7 V11 M9.2,7 V11</StreamGeometry>
    <StreamGeometry x:Key="Icon.Duplicate">M5.5,5.5 H13 V13 H5.5 Z M3,10.5 V3 H10.5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Follow">M6,2.5 V13.5 M9,5.5 L12,8 L9,10.5 M6,8 H12</StreamGeometry>
    <StreamGeometry x:Key="Icon.ChevronDown">M4,6 L8,10 L12,6</StreamGeometry>
    <StreamGeometry x:Key="Icon.ChevronRight">M6,4 L10,8 L6,12</StreamGeometry>
    <StreamGeometry x:Key="Icon.MidiPort">M8,2 A6,6 0 1 1 7.99,2 Z M4.8,8.3 H4.9 M5.8,5.6 H5.9 M8,4.6 H8.1 M10.2,5.6 H10.3 M11.2,8.3 H11.3 M7,12 H9</StreamGeometry>
    <StreamGeometry x:Key="Icon.Quantize">M2.5,2.5 V13.5 M6.5,2.5 V13.5 M10.5,2.5 V13.5 M3.5,7 H6 M7.5,10 H10</StreamGeometry>
    <StreamGeometry x:Key="Icon.Velocity">M3,13.5 V9 M6.5,13.5 V5 M10,13.5 V7 M13.5,13.5 V3 M2.2,9 H3.8 M5.7,5 H7.3 M9.2,7 H10.8 M12.7,3 H14.3</StreamGeometry>
    <StreamGeometry x:Key="Icon.Keyboard">M1.5,4 H14.5 V12 H1.5 Z M3.8,6.3 H4 M6.2,6.3 H6.4 M8.6,6.3 H8.8 M11,6.3 H11.2 M5,8.3 H5.2 M7.4,8.3 H7.6 M9.8,8.3 H10 M12.2,8.3 H12.4 M5,10.2 H11</StreamGeometry>
    <StreamGeometry x:Key="Icon.ZoomIn">M7,2.5 A4.5,4.5 0 1 1 6.99,2.5 Z M10.3,10.3 L13.8,13.8 M4.8,7 H9.2 M7,4.8 V9.2</StreamGeometry>
    <StreamGeometry x:Key="Icon.ZoomFit">M2.5,6 V2.5 H6 M10,2.5 H13.5 V6 M13.5,10 V13.5 H10 M6,13.5 H2.5 V10 M5.5,8 H10.5 M5.5,8 L7,6.5 M5.5,8 L7,9.5 M10.5,8 L9,6.5 M10.5,8 L9,9.5</StreamGeometry>
    <StreamGeometry x:Key="Icon.ZoomOut">M7,2.5 A4.5,4.5 0 1 1 6.99,2.5 Z M10.3,10.3 L13.8,13.8 M4.8,7 H9.2</StreamGeometry>
    <StreamGeometry x:Key="Icon.Logo">M1,9 H4 V15 H1 Z M6,5 H9 V15 H6 Z M11,1 H14 V15 H11 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Check">M2,8 L6,12 L14,4 L12.6,2.6 L6,9.2 L3.4,6.6 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Warning">M8,1 L15,14 H1 Z M7.2,5 V10 H8.8 V5 Z M7.2,11 V12.6 H8.8 V11 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Offline">M8,1 A7,7 0 1 1 7.99,1 Z M5,4 L4,5 L11,12 L12,11 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Dot">M8,5 A3,3 0 1 1 7.99,5 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Speaker">M2.5,6 H5 L8.5,3 V13 L5,10 H2.5 Z M10.8,5.6 Q12.4,8 10.8,10.4 M12.6,3.8 Q15.4,8 12.6,12.2</StreamGeometry>
    <StreamGeometry x:Key="Icon.Plug">M5.5,2 V5 M10.5,2 V5 M3.5,5 H12.5 V8 A4.5,4.5 0 0 1 3.5,8 Z M8,12.5 V14.5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Settings">M8,5.5 A2.5,2.5 0 1 1 7.99,5.5 Z M8,1.8 V3.6 M8,12.4 V14.2 M1.8,8 H3.6 M12.4,8 H14.2 M3.6,3.6 L4.9,4.9 M11.1,11.1 L12.4,12.4 M3.6,12.4 L4.9,11.1 M11.1,4.9 L12.4,3.6</StreamGeometry>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource Surface.Base}" />
    <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Surfaces: panes are flush and separated by dark hairlines, not floating cards. -->
  <Style Selector="Border.pane">
    <Setter Property="Background" Value="{StaticResource Surface.Panel}" />
  </Style>
  <Style Selector="Border.bar">
    <Setter Property="Background" Value="{StaticResource Gradient.Bar}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line.Divider}" />
  </Style>
  <Style Selector="Border.header">
    <Setter Property="Background" Value="{StaticResource Gradient.Header}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line.Divider}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.hairline">
    <Setter Property="Background" Value="{StaticResource Line.Divider}" />
  </Style>
  <Style Selector="Border.separator">
    <Setter Property="Background" Value="{StaticResource Line.Border}" />
    <Setter Property="Width" Value="1" />
    <Setter Property="Margin" Value="6,4" />
  </Style>
  <Style Selector="GridSplitter.hairline">
    <Setter Property="Background" Value="{StaticResource Line.Divider}" />
    <Setter Property="MinWidth" Value="1" />
    <Setter Property="MinHeight" Value="1" />
  </Style>

  <!-- Type -->
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.overline">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Compact Fluent controls -->
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="8,2,0,2" />
    <Setter Property="Background" Value="{StaticResource Gradient.Button}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line.Edge}" />
  </Style>
  <Style Selector="ComboBox.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="NumericUpDown">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="NumericUpDown.compact">
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="Background" Value="{StaticResource Surface.Field}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line.Divider}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
  </Style>
  <Style Selector="NumericUpDown.compact /template/ TextBox">
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="24" />
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Background" Value="{StaticResource Surface.Overlay}" />
    <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line.Edge}" />
    <Setter Property="Padding" Value="7,4" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Button, ToggleButton">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
    <Setter Property="Padding" Value="9,3" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="24" />
  </Style>
  <Style Selector="Button.raised">
    <Setter Property="Background" Value="{StaticResource Gradient.Button}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line.Edge}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.raised:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource State.Pressed}" />
  </Style>
  <Style Selector="Button.ghost, DropDownButton.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource State.Hover}" />
    <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,2" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource Accent.Hover}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Control.LinkHover}" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="Foreground" Value="{StaticResource Text.OnAccent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Accent.Hover}" />
    <Setter Property="Foreground" Value="{StaticResource Text.OnAccent}" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource Control.DangerBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource Control.DangerForeground}" />
  </Style>

  <!--
    Tool buttons: square, icon-only, used in the control bar and pane headers. Checked tool buttons
    light up in the accent (or a semantic colour via .cycle, .record, .play).
  -->
  <Style Selector="Button.tool, ToggleButton.tool">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="24" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.tool:pointerover /template/ ContentPresenter, ToggleButton.tool:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource State.Hover}" />
  </Style>
  <Style Selector="Button.tool:pointerover, ToggleButton.tool:pointerover">
    <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
  </Style>
  <Style Selector="Button.tool:pressed /template/ ContentPresenter, ToggleButton.tool:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource State.Pressed}" />
  </Style>
  <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource State.SelectedSubtle}" />
  </Style>
  <Style Selector="ToggleButton.tool:checked">
    <Setter Property="Foreground" Value="{StaticResource Control.CheckedForeground}" />
  </Style>
  <Style Selector="Button.tool:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.tool:disabled PathIcon">
    <Setter Property="Opacity" Value="0.35" />
  </Style>

  <!-- Transport: a segmented strip of raised buttons. -->
  <Style Selector="Border.transport">
    <Setter Property="Background" Value="{StaticResource Line.Edge}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line.Divider}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="1" />
  </Style>
  <Style Selector="Border.transport > StackPanel > :is(Button)">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="{StaticResource Gradient.Button}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource Control.Foreground}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.transport > StackPanel > :is(Button):pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Control.Hover}" />
  </Style>
  <Style Selector="Border.transport > StackPanel > :is(Button):pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource TrackRow.Hover}" />
  </Style>
  <Style Selector="Border.transport ToggleButton.play:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Transport.Play}" />
  </Style>
  <Style Selector="Border.transport ToggleButton.play:checked">
    <Setter Property="Foreground" Value="{StaticResource Transport.PlayForeground}" />
  </Style>
  <Style Selector="Border.transport ToggleButton.record">
    <Setter Property="Foreground" Value="{StaticResource Transport.RecordIdle}" />
  </Style>
  <Style Selector="Border.transport ToggleButton.record:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Transport.Record}" />
  </Style>
  <Style Selector="Border.transport ToggleButton.record:checked">
    <Setter Property="Foreground" Value="{StaticResource Transport.RecordForeground}" />
  </Style>
  <Style Selector="Border.transport ToggleButton.cycle:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Transport.CycleOn}" />
  </Style>
  <Style Selector="Border.transport ToggleButton.cycle:checked">
    <Setter Property="Foreground" Value="{StaticResource Transport.CycleForeground}" />
  </Style>
  <Style Selector="Border.transport ToggleButton.mode:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource State.SelectedSubtle}" />
  </Style>
  <Style Selector="Border.transport ToggleButton.mode:checked">
    <Setter Property="Foreground" Value="{StaticResource Transport.ModeForeground}" />
  </Style>

  <!-- Computer keyboard: an accent-lit toggle with a slide-out LCD readout of octave and velocity. -->
  <Style Selector="Border.transport ToggleButton.keys:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Transport.Keys}" />
    <Setter Property="BoxShadow" Value="0 0 8 0 #666FD8F2" />
  </Style>
  <Style Selector="Border.transport ToggleButton.keys:checked">
    <Setter Property="Foreground" Value="{StaticResource Transport.KeysForeground}" />
  </Style>
  <Style Selector="Border.keysReadout">
    <Setter Property="Background" Value="{StaticResource Lcd}" />
    <Setter Property="BorderBrush" Value="{StaticResource Transport.KeysEdge}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="Height" Value="30" />
    <Setter Property="BoxShadow" Value="inset 0 1 3 0 #90000000" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="RenderTransform" Value="translateX(-6px)" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.keysReadout.on">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="IsHitTestVisible" Value="True" />
    <Setter Property="RenderTransform" Value="translateX(0px)" />
  </Style>
  <Style Selector="TextBlock.keysValue">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource Transport.KeysForeground}" />
  </Style>
  <Style Selector="ProgressBar.keysMeter">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="3" />
    <Setter Property="CornerRadius" Value="1.5" />
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="1" />
    <Setter Property="Background" Value="{StaticResource Transport.KeysIdle}" />
    <Setter Property="Foreground" Value="{StaticResource Transport.KeysForeground}" />
  </Style>
  <Style Selector="Ellipse.keysActivity">
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="Fill" Value="{StaticResource Transport.KeysIdle}" />
  </Style>
  <Style Selector="Ellipse.keysActivity.on">
    <Setter Property="Fill" Value="{StaticResource Transport.KeysForeground}" />
  </Style>

  <!-- The LCD: a recessed display of position, time, tempo, and meter. -->
  <Style Selector="Border.lcd">
    <Setter Property="Background" Value="{StaticResource Lcd}" />
    <Setter Property="BorderBrush" Value="{StaticResource Lcd.Edge}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BoxShadow" Value="inset 0 1 3 0 #90000000" />
  </Style>
  <Style Selector="TextBlock.lcd">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="Foreground" Value="{StaticResource Lcd.Text}" />
  </Style>
  <Style Selector="TextBlock.lcdLabel">
    <Setter Property="FontSize" Value="8.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.8" />
    <Setter Property="Foreground" Value="{StaticResource Lcd.Label}" />
  </Style>
  <Style Selector="TextBox.lcd">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="Foreground" Value="{StaticResource Lcd.Text}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="CaretBrush" Value="{StaticResource Lcd.Text}" />
  </Style>
  <!-- The loop's fields stay readable but step back while looping is off. -->
  <Style Selector="StackPanel.loopOff">
    <Setter Property="Opacity" Value="0.55" />
  </Style>
  <Style Selector="TextBox.lcd:pointerover /template/ Border#PART_BorderElement, TextBox.lcd:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource Surface.Sunken}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="PathIcon.stroke">
    <Setter Property="Template">
      <ControlTemplate>
        <Viewbox Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
          <Path Data="{TemplateBinding Data}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.35"
                StrokeLineCap="Round" StrokeJoin="Round" Width="16" Height="16" />
        </Viewbox>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="PathIcon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>

  <!-- Track header buttons: automation, Mute, Solo, Record arm. Letters or icons plus colour; names for screen readers. -->
  <Style Selector="ToggleButton.trackButton, Button.trackButton">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="17" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{StaticResource Gradient.Button}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line.Edge}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource Control.Idle}" />
  </Style>
  <Style Selector="ToggleButton.trackButton:pointerover /template/ ContentPresenter, Button.trackButton:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Control.Hover}" />
  </Style>
  <Style Selector="ToggleButton.trackButton.mute:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Track.Mute}" />
  </Style>
  <Style Selector="ToggleButton.trackButton.mute:checked">
    <Setter Property="Foreground" Value="{StaticResource Text.OnAccent}" />
  </Style>
  <Style Selector="ToggleButton.trackButton.solo:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Track.Solo}" />
  </Style>
  <Style Selector="ToggleButton.trackButton.solo:checked">
    <Setter Property="Foreground" Value="{StaticResource Track.SoloForeground}" />
  </Style>
  <Style Selector="ToggleButton.trackButton.arm">
    <Setter Property="Foreground" Value="{StaticResource Track.ArmIdle}" />
  </Style>
  <Style Selector="ToggleButton.trackButton.arm:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource State.Error}" />
  </Style>
  <Style Selector="ToggleButton.trackButton.arm:checked">
    <Setter Property="Foreground" Value="{StaticResource Text.OnAccent}" />
  </Style>

  <!-- Status chips -->
  <Style Selector="Border.chip">
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Padding" Value="5,1" />
    <Setter Property="Background" Value="{StaticResource Surface.Raised}" />
  </Style>

  <!-- Lower pane tabs -->
  <Style Selector="RadioButton.tab">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Tab" Background="Transparent" Padding="10,0" BorderThickness="0,0,0,2" BorderBrush="Transparent">
          <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="RadioButton.tab:pointerover">
    <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
  </Style>
  <Style Selector="RadioButton.tab:checked /template/ Border#PART_Tab">
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    <Setter Property="Background" Value="{StaticResource Tab.Checked}" />
  </Style>
  <Style Selector="RadioButton.tab:checked">
    <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
  </Style>
  <Style Selector="RadioButton.tab:focus-visible /template/ Border#PART_Tab">
    <Setter Property="Background" Value="{StaticResource Tab.Focus}" />
  </Style>

  <!-- Inspector sections -->
  <Style Selector="Expander.section">
    <Setter Property="Padding" Value="10,6,10,10" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Expander.section /template/ ToggleButton#ExpanderHeader">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="{StaticResource Gradient.Header}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line.Divider}" />
    <Setter Property="BorderThickness" Value="0,1,0,1" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Expander.section /template/ Border#ExpanderContent">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="Expander.section /template/ ToggleButton#ExpanderHeader">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <!-- A closed section's one-line state, right of its title: "Off", "Synth · Ch 3". -->
  <Style Selector="TextBlock.sectionSummary">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="Margin" Value="{StaticResource Inset.Header}" />
  </Style>
  <Style Selector="TextBlock.sectionSummary.active">
    <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
  </Style>

  <!-- The inspector's title block and label/value rows. -->
  <Style Selector="Grid.inspectorTitle">
    <Setter Property="Margin" Value="10,10,10,8" />
  </Style>
  <Style Selector="Border.trackSwatch">
    <Setter Property="Width" Value="4" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Small}" />
    <Setter Property="Margin" Value="0,1,8,1" />
  </Style>
  <Style Selector="StackPanel.fields">
    <Setter Property="Spacing" Value="{StaticResource Space.S}" />
  </Style>
  <Style Selector="Grid.field">
    <Setter Property="MinHeight" Value="{StaticResource Height.Control}" />
  </Style>
  <!-- A value that opens where it is edited (the instrument in the Device View): a field, not a push button. -->
  <Style Selector="Button.value">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="{StaticResource Height.Control}" />
    <Setter Property="Padding" Value="8,0,6,0" />
    <Setter Property="Background" Value="{StaticResource Surface.Field}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
  </Style>
  <Style Selector="Button.value:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource State.Hover}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line.BorderStrong}" />
  </Style>
  <Style Selector="Button.value.empty">
    <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line.BorderStrong}" />
  </Style>
  <Style Selector="Button.value TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.value PathIcon">
    <Setter Property="Width" Value="{StaticResource Icon.SizeSmall}" />
    <Setter Property="Height" Value="{StaticResource Icon.SizeSmall}" />
    <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
    <Setter Property="Margin" Value="6,0,0,0" />
  </Style>

  <!-- Settings: a category list beside the page, in the workspace's own chrome. -->
  <Style Selector="Border.settingsNav">
    <Setter Property="Width" Value="{StaticResource Width.SettingsNav}" />
    <Setter Property="Background" Value="{StaticResource Surface.Panel}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line.Divider}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>
  <Style Selector="ListBox.settingsCategories">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0,2" />
  </Style>
  <Style Selector="ListBox.settingsCategories ListBoxItem">
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="{StaticResource Height.Row}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
  </Style>
  <Style Selector="ListBox.settingsCategories ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource State.Selected}" />
  </Style>
  <Style Selector="ListBox.settingsCategories ListBoxItem PathIcon">
    <Setter Property="Width" Value="{StaticResource Icon.SizeMedium}" />
    <Setter Property="Height" Value="{StaticResource Icon.SizeMedium}" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
  </Style>
  <Style Selector="ListBox.settingsCategories ListBoxItem TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.settingsHeader">
    <Setter Property="Padding" Value="24,12,16,12" />
    <Setter Property="Background" Value="{StaticResource Surface.Panel}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line.Divider}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="TextBlock.settingsCrumb">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Title}" />
    <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.settingsTitle">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Title}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Panel.settingsPage">
    <Setter Property="MaxWidth" Value="{StaticResource Width.SettingsPage}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Margin" Value="24,16,24,24" />
  </Style>
  <Style Selector="StackPanel.settingsGroups">
    <Setter Property="Spacing" Value="{StaticResource Space.XXL}" />
  </Style>
  <Style Selector="StackPanel.settingsGroup">
    <Setter Property="Spacing" Value="{StaticResource Space.M}" />
  </Style>
  <Style Selector="StackPanel.settingsGroup > TextBlock.overline">
    <Setter Property="Margin" Value="0,0,0,2" />
  </Style>
  <Style Selector="Grid.settingRow">
    <Setter Property="MinHeight" Value="{StaticResource Height.Control}" />
  </Style>
  <Style Selector="TextBlock.settingHint">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
    <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
  </Style>

  <!-- Dense lists (messages, monitor, event list) -->
  <Style Selector="ListBox.dense">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.dense ListBoxItem">
    <Setter Property="Padding" Value="10,1" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="ListBox.grid ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="22" />
  </Style>
  <Style Selector="ListBox.grid ListBoxItem:nth-child(2n)">
    <Setter Property="Background" Value="{StaticResource List.Alternate}" />
  </Style>
  <Style Selector="ListBox.grid ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource State.Selected}" />
  </Style>
  <Style Selector="TextBox.cell">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="22" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="11.5" />
  </Style>
  <Style Selector="TextBox.cell:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource List.CellHover}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.cell:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource Surface.Field}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBox.field">
    <Setter Property="Background" Value="{StaticResource Surface.Field}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line.Divider}" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="11.5" />
  </Style>

  <!-- Track list rows -->
  <Style Selector="ListBox.tracks">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.tracks ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Height" Value="50" />
    <Setter Property="Background" Value="{StaticResource TrackRow}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line.Edge}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="ListBox.tracks ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource TrackRow.Hover}" />
  </Style>
  <Style Selector="ListBox.tracks ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource TrackRow.Selected}" />
  </Style>
  <Style Selector="TextBox.inline">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBox.clipName">
    <Setter Property="Padding" Value="3,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="1.5" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.inline:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource Surface.Base}" />
  </Style>

  <!-- Keep keyboard focus clearly visible on every restyled control. -->
  <Style Selector=":is(Button):focus-visible /template/ ContentPresenter, ToggleButton:focus-visible /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource Accent.Hover}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <!-- ============================================================================================================
       Workspace (ADR 0036): rails, dock headers, resize handles.
       ============================================================================================================ -->
  <Style Selector="controls|ResizeHandle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="{TemplateBinding Background}">
          <Border x:Name="PART_Line" Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="controls|ResizeHandle.vertical /template/ Border#PART_Line">
    <Setter Property="Width" Value="NaN" />
    <Setter Property="Height" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="controls|ResizeHandle:pointerover /template/ Border#PART_Line, controls|ResizeHandle:pressed /template/ Border#PART_Line">
    <Setter Property="Background" Value="{StaticResource Accent}" />
  </Style>

  <Style Selector="Border.rail">
    <Setter Property="Width" Value="{StaticResource Width.Rail}" />
    <Setter Property="Background" Value="{StaticResource Surface.Chrome}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line.Divider}" />
    <Setter Property="Padding" Value="0,6" />
  </Style>
  <Style Selector="Border.rail.left">
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>
  <Style Selector="Border.rail.right">
    <Setter Property="BorderThickness" Value="1,0,0,0" />
  </Style>
  <Style Selector="Button.railItem">
    <Setter Property="Width" Value="{StaticResource Width.Rail}" />
    <Setter Property="Padding" Value="0,8" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.None}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.railItem PathIcon">
    <Setter Property="Width" Value="{StaticResource Icon.SizeMedium}" />
    <Setter Property="Height" Value="{StaticResource Icon.SizeMedium}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.railItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource State.Hover}" />
  </Style>
  <Style Selector="Button.railItem:pointerover">
    <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
  </Style>
  <!-- A docked side tool's icon is marked as open; a click collapses it again. -->
  <Style Selector="Button.railItem.open">
    <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="Border.rail.left Button.railItem.open">
    <Setter Property="BorderThickness" Value="2,0,0,0" />
  </Style>
  <Style Selector="Border.rail.right Button.railItem.open">
    <Setter Property="BorderThickness" Value="0,0,2,0" />
  </Style>
  <!-- A detached view's icon is lit: its window is open elsewhere. One awaiting a missing monitor is dimmed. -->
  <Style Selector="Button.railItem.detached">
    <Setter Property="Foreground" Value="{StaticResource Control.CheckedForeground}" />
  </Style>
  <Style Selector="Button.railItem.awaiting">
    <Setter Property="Foreground" Value="{StaticResource State.Offline}" />
  </Style>

  <Style Selector="Border.dockHeader">
    <Setter Property="Height" Value="{StaticResource Height.Header}" />
    <Setter Property="Padding" Value="10,0,4,0" />
    <Setter Property="Background" Value="{StaticResource Surface.Panel}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line.Divider}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="TextBlock.dockTitle">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.8" />
    <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.viewHeader">
    <Setter Property="Height" Value="{StaticResource Height.Header}" />
    <Setter Property="Padding" Value="0,0,4,0" />
    <Setter Property="Background" Value="{StaticResource Surface.Panel}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line.Divider}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.trackAccent">
    <Setter Property="Width" Value="3" />
    <Setter Property="Margin" Value="0,0,6,0" />
  </Style>
  <Style Selector="TextBlock.viewTitle">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
    <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
  </Style>
  <Style Selector="TextBlock.micro">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Micro}" />
    <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.tool.small">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="22" />
  </Style>
  <Style Selector="Button.tool.small PathIcon, ToggleButton.tool.small PathIcon">
    <Setter Property="Width" Value="{StaticResource Icon.SizeSmall}" />
    <Setter Property="Height" Value="{StaticResource Icon.SizeSmall}" />
  </Style>
  <Style Selector="ToggleButton.tool.small">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="22" />
  </Style>
  <Style Selector="Button.tool.tiny">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
  </Style>
  <Style Selector="Button.tool.tiny PathIcon">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
  </Style>
  <Style Selector="Button.compact">
    <Setter Property="MinHeight" Value="{StaticResource Height.Compact}" />
    <Setter Property="Height" Value="{StaticResource Height.Compact}" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.link.micro">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Micro}" />
  </Style>
  <Style Selector="StackPanel.emptyState">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Spacing" Value="8" />
  </Style>
  <Style Selector="StackPanel.emptyState > PathIcon">
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.emptyTitle">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- ============================================================================================================
       Device View: the chain canvas, boundary nodes, links, and device panels of fixed height and width class.
       ============================================================================================================ -->
  <Style Selector="Panel.chainCanvas">
    <Setter Property="Background" Value="{StaticResource Surface.Sunken}" />
  </Style>
  <Style Selector="Border.chainNode">
    <Setter Property="Width" Value="{StaticResource DevicePanel.NodeWidth}" />
    <Setter Property="Height" Value="{StaticResource DevicePanel.Height}" />
  </Style>
  <Style Selector="Ellipse.nodeDot">
    <Setter Property="Width" Value="{StaticResource DevicePanel.NodeSize}" />
    <Setter Property="Height" Value="{StaticResource DevicePanel.NodeSize}" />
    <Setter Property="Stroke" Value="{StaticResource Text.Muted}" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Ellipse.nodeDot.routed">
    <Setter Property="Stroke" Value="{StaticResource Signal.Audio}" />
  </Style>
  <!-- Where the chain's signal comes from and goes, under its boundary node. -->
  <Style Selector="TextBlock.nodeDetail">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Micro}" />
    <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="MaxWidth" Value="{StaticResource DevicePanel.NodeWidth}" />
  </Style>
  <Style Selector="TextBlock.nodeDetail.unrouted">
    <Setter Property="Foreground" Value="{StaticResource State.Warning}" />
  </Style>
  <!-- The empty chain's slot: the size of a panel, outlined, the place a first device goes. -->
  <Style Selector="Panel.emptySlot">
    <Setter Property="Width" Value="{StaticResource DevicePanel.LargeWidth}" />
    <Setter Property="Height" Value="{StaticResource DevicePanel.Height}" />
  </Style>
  <Style Selector="Rectangle.slotOutline">
    <Setter Property="Stroke" Value="{StaticResource Line.BorderStrong}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="StrokeDashArray" Value="4,3" />
    <Setter Property="RadiusX" Value="4" />
    <Setter Property="RadiusY" Value="4" />
    <Setter Property="Fill" Value="Transparent" />
  </Style>
  <Style Selector="Panel.emptySlot.dropTarget Rectangle.slotOutline">
    <Setter Property="Stroke" Value="{StaticResource State.Focus}" />
    <Setter Property="Fill" Value="{StaticResource State.SelectedSubtle}" />
  </Style>
  <Style Selector="StackPanel.slotContent">
    <Setter Property="Spacing" Value="{StaticResource Space.M}" />
    <Setter Property="Margin" Value="{StaticResource Inset.Section}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="StackPanel.slotContent > PathIcon">
    <Setter Property="Width" Value="{StaticResource Icon.SizeLarge}" />
    <Setter Property="Height" Value="{StaticResource Icon.SizeLarge}" />
    <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.slotTitle">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.nodeLabel">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Micro}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.8" />
    <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <!-- The link into each device: a hairline at header height, so the chain reads left to right. -->
  <Style Selector="Border.chainLink">
    <Setter Property="Width" Value="{StaticResource DevicePanel.Gap}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="0,105,0,0" />
    <Setter Property="Background" Value="{StaticResource Line.BorderStrong}" />
  </Style>
  <Style Selector="Border.chainLink.bypassed">
    <Setter Property="Background" Value="{StaticResource Line.Border}" />
  </Style>
  <Style Selector="Border.insertionMarker">
    <Setter Property="Width" Value="3" />
    <Setter Property="Height" Value="{StaticResource DevicePanel.Height}" />
    <Setter Property="CornerRadius" Value="1.5" />
    <Setter Property="Background" Value="{StaticResource State.Focus}" />
    <Setter Property="BoxShadow" Value="{StaticResource Shadow.Focus}" />
  </Style>

  <!-- A device dropped over a panel replaces it: the whole panel is outlined and says so, plainly. -->
  <Style Selector="Border.replaceOverlay">
    <Setter Property="Height" Value="{StaticResource DevicePanel.Height}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="{StaticResource State.Focus}" />
    <Setter Property="Background" Value="{StaticResource Overlay.Replace}" />
    <Setter Property="BoxShadow" Value="{StaticResource Shadow.Focus}" />
  </Style>
  <Style Selector="TextBlock.replaceTitle">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource State.Focus}" />
  </Style>
  <Style Selector="TextBlock.replaceDetail">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="Margin" Value="8,0" />
  </Style>

  <Style Selector="Border.devicePanel">
    <Setter Property="Height" Value="{StaticResource DevicePanel.Height}" />
    <Setter Property="Background" Value="{StaticResource Surface.Panel}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line.Edge}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Panel}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.devicePanel.selected">
    <Setter Property="BorderBrush" Value="{StaticResource State.Focus}" />
  </Style>
  <Style Selector="Border.devicePanel.unavailable">
    <Setter Property="Background" Value="{StaticResource State.ErrorSurface}" />
  </Style>
  <Style Selector="Border.devicePanel.bypassed Panel.deviceBody, Border.devicePanel.bypassed TextBlock.deviceName">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="Border.deviceHeader">
    <Setter Property="Height" Value="{StaticResource DevicePanel.HeaderHeight}" />
    <Setter Property="Padding" Value="4,2,2,0" />
    <Setter Property="Background" Value="{StaticResource Surface.Raised}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line.Divider}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.devicePanel.selected Border.deviceHeader">
    <Setter Property="Background" Value="{StaticResource State.SelectedSubtle}" />
  </Style>
  <Style Selector="Border.devicePanel.bypassed Border.roleStripe">
    <Setter Property="Opacity" Value="0.35" />
  </Style>
  <Style Selector="Border.roleStripe">
    <Setter Property="Height" Value="2" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="-4,-2,-2,0" />
  </Style>
  <Style Selector="Border.devicePanel.collapsed Border.roleStripe">
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="TextBlock.deviceName">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="4,0" />
    <Setter Property="Cursor" Value="SizeAll" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{StaticResource Surface.Raised}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Small}" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="Height" Value="14" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,2,0" />
  </Style>
  <Style Selector="Border.badge > TextBlock">
    <Setter Property="FontSize" Value="8.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.5" />
    <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.power">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Round}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource Accent.Hover}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.power PathIcon">
    <Setter Property="Width" Value="11" />
    <Setter Property="Height" Value="11" />
  </Style>
  <Style Selector="Button.power.off">
    <Setter Property="Foreground" Value="{StaticResource Text.Disabled}" />
  </Style>
  <Style Selector="Button.power:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource State.Hover}" />
  </Style>
  <Style Selector="Panel.deviceBody">
    <Setter Property="Margin" Value="6,6,6,0" />
  </Style>
  <!-- Controls sit as a balanced block in the panel's fixed height, not packed against its top. -->
  <Style Selector="Panel.deviceBody > ItemsControl">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="StackPanel.knobCell">
    <Setter Property="Width" Value="{StaticResource DevicePanel.KnobCellWidth}" />
    <Setter Property="Height" Value="{StaticResource DevicePanel.KnobCellHeight}" />
    <Setter Property="Spacing" Value="1" />
  </Style>
  <Style Selector="StackPanel.knobCell > controls|Knob">
    <Setter Property="Width" Value="{StaticResource DevicePanel.KnobSize}" />
    <Setter Property="Height" Value="{StaticResource DevicePanel.KnobSize}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.knobLabel">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
    <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="MaxWidth" Value="60" />
  </Style>
  <Style Selector="TextBlock.knobValue">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Micro}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="MaxWidth" Value="60" />
  </Style>
  <!-- On/off parameters: a row with a small lamp that is lit when on. -->
  <Style Selector="ToggleButton.paramSwitch">
    <Setter Property="Width" Value="{StaticResource DevicePanel.SwitchWidth}" />
    <Setter Property="Height" Value="{StaticResource DevicePanel.SwitchHeight}" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Small}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.paramSwitch:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource State.Hover}" />
  </Style>
  <Style Selector="ToggleButton.paramSwitch:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.paramSwitch:checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource State.Hover}" />
  </Style>
  <Style Selector="ToggleButton.paramSwitch:focus-visible /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource State.Focus}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.switchLamp">
    <Setter Property="Width" Value="{StaticResource DevicePanel.LampSize}" />
    <Setter Property="Height" Value="{StaticResource DevicePanel.LampSize}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Round}" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{StaticResource Surface.Overlay}" />
  </Style>
  <Style Selector="ToggleButton.paramSwitch:checked Border.switchLamp">
    <Setter Property="Background" Value="{StaticResource Signal.Note}" />
  </Style>
  <Style Selector="TextBlock.switchLabel">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
    <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="ToggleButton.paramSwitch:checked TextBlock.switchLabel">
    <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
  </Style>
  <Style Selector="StackPanel.deviceNotice">
    <Setter Property="Spacing" Value="6" />
    <Setter Property="Margin" Value="2,4" />
  </Style>
  <Style Selector="TextBlock.statusTitle">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource State.Warning}" />
  </Style>
  <Style Selector="Grid.deviceFooter">
    <Setter Property="Height" Value="{StaticResource DevicePanel.FooterHeight}" />
    <Setter Property="Margin" Value="8,0,4,0" />
  </Style>
  <Style Selector="Button.collapsedName">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,6" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
  </Style>
  <Style Selector="Button.collapsedName:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource State.Hover}" />
  </Style>

  <!-- ============================================================================================================
       Browser: search field, category chips, items, and the insertion target.
       ============================================================================================================ -->
  <Style Selector="Border.searchField">
    <Setter Property="Height" Value="{StaticResource Height.Control}" />
    <Setter Property="Background" Value="{StaticResource Surface.Field}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line.Divider}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
  </Style>
  <Style Selector="Border.searchField:focus-within">
    <Setter Property="BorderBrush" Value="{StaticResource State.Focus}" />
  </Style>
  <Style Selector="TextBox.bare">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
  </Style>
  <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement, TextBox.bare:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.chips">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>
  <Style Selector="ListBox.chips ListBoxItem">
    <Setter Property="Height" Value="20" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Margin" Value="2" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
    <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
    <Setter Property="Background" Value="{StaticResource Surface.Raised}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.chips ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource State.Hover}" />
  </Style>
  <Style Selector="ListBox.chips ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource State.SelectedSubtle}" />
  </Style>
  <Style Selector="ListBox.chips ListBoxItem:selected">
    <Setter Property="Foreground" Value="{StaticResource Control.CheckedForeground}" />
  </Style>
  <Style Selector="ListBox.browser">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.browser ListBoxItem">
    <Setter Property="Padding" Value="10,4,8,4" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="ListBox.browser ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource State.Selected}" />
  </Style>
  <Style Selector="Ellipse.roleDot">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.itemName">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
  </Style>
  <Style Selector="TextBlock.itemDetail">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
    <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
  </Style>
  <Style Selector="Border.suggested">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Small}" />
    <Setter Property="Padding" Value="4,1" />
    <Setter Property="Margin" Value="6,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{StaticResource State.SelectedSubtle}" />
  </Style>
  <Style Selector="Border.suggested > TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Micro}" />
    <Setter Property="Foreground" Value="{StaticResource Control.CheckedForeground}" />
  </Style>
  <Style Selector="Border.browserFooter">
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="10,0,8,0" />
    <Setter Property="BorderBrush" Value="{StaticResource Line.Divider}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Background" Value="{StaticResource Surface.Panel}" />
  </Style>
  <Style Selector="Ellipse.targetDot">
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Fill" Value="{StaticResource Text.Disabled}" />
  </Style>
  <Style Selector="Ellipse.targetDot.on">
    <Setter Property="Fill" Value="{StaticResource State.Success}" />
  </Style>
</Styles>
