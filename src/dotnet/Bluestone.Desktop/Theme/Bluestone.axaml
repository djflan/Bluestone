<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Bluestone design system, layered on Fluent: neutral charcoal surfaces divided by hairlines (no
    floating cards), compact controls, a monochrome 16-unit icon set, and colour reserved for
    meaning (track colours, record, cycle, mute and solo).
  -->
  <Styles.Resources>
    <Color x:Key="Bluestone.BaseColor">#1C1C1E</Color>
    <Color x:Key="Bluestone.PanelColor">#252527</Color>
    <Color x:Key="Bluestone.RaisedColor">#2E2E31</Color>
    <Color x:Key="Bluestone.HoverColor">#38383C</Color>
    <Color x:Key="Bluestone.PressedColor">#434348</Color>
    <Color x:Key="Bluestone.DividerColor">#111113</Color>
    <Color x:Key="Bluestone.BorderColor">#3A3A3E</Color>
    <Color x:Key="Bluestone.BorderStrongColor">#4A4A50</Color>
    <Color x:Key="Bluestone.TextColor">#D9D9DC</Color>
    <Color x:Key="Bluestone.TextSecondaryColor">#A1A1A7</Color>
    <Color x:Key="Bluestone.TextMutedColor">#6E6E75</Color>
    <Color x:Key="Bluestone.AccentColor">#4C8DDB</Color>
    <Color x:Key="Bluestone.AccentHoverColor">#6AA2E4</Color>
    <Color x:Key="Bluestone.OnAccentColor">#FFFFFF</Color>
    <Color x:Key="Bluestone.DangerColor">#E5484D</Color>
    <Color x:Key="Bluestone.WarningColor">#E0A43A</Color>
    <Color x:Key="Bluestone.SuccessColor">#4CB873</Color>
    <Color x:Key="Bluestone.CycleColor">#C9A227</Color>
    <Color x:Key="Bluestone.MuteColor">#4C8DDB</Color>
    <Color x:Key="Bluestone.SoloColor">#E3C345</Color>
    <Color x:Key="Bluestone.LcdColor">#141416</Color>
    <Color x:Key="Bluestone.LcdTextColor">#ECEDEF</Color>
    <Color x:Key="Bluestone.LcdLabelColor">#74767D</Color>

    <SolidColorBrush x:Key="Bluestone.Base" Color="{StaticResource Bluestone.BaseColor}" />
    <SolidColorBrush x:Key="Bluestone.Panel" Color="{StaticResource Bluestone.PanelColor}" />
    <SolidColorBrush x:Key="Bluestone.Raised" Color="{StaticResource Bluestone.RaisedColor}" />
    <SolidColorBrush x:Key="Bluestone.Hover" Color="{StaticResource Bluestone.HoverColor}" />
    <SolidColorBrush x:Key="Bluestone.Pressed" Color="{StaticResource Bluestone.PressedColor}" />
    <SolidColorBrush x:Key="Bluestone.Divider" Color="{StaticResource Bluestone.DividerColor}" />
    <!-- Matches Palette.AutomationLane, the background of automation lanes in the arrangement. -->
    <SolidColorBrush x:Key="Bluestone.AutomationLane" Color="#1D1D1F" />
    <SolidColorBrush x:Key="Bluestone.Border" Color="{StaticResource Bluestone.BorderColor}" />
    <SolidColorBrush x:Key="Bluestone.BorderStrong" Color="{StaticResource Bluestone.BorderStrongColor}" />
    <SolidColorBrush x:Key="Bluestone.Text" Color="{StaticResource Bluestone.TextColor}" />
    <SolidColorBrush x:Key="Bluestone.TextSecondary" Color="{StaticResource Bluestone.TextSecondaryColor}" />
    <SolidColorBrush x:Key="Bluestone.TextMuted" Color="{StaticResource Bluestone.TextMutedColor}" />
    <SolidColorBrush x:Key="Bluestone.Accent" Color="{StaticResource Bluestone.AccentColor}" />
    <SolidColorBrush x:Key="Bluestone.AccentHover" Color="{StaticResource Bluestone.AccentHoverColor}" />
    <SolidColorBrush x:Key="Bluestone.OnAccent" Color="{StaticResource Bluestone.OnAccentColor}" />
    <SolidColorBrush x:Key="Bluestone.Danger" Color="{StaticResource Bluestone.DangerColor}" />
    <SolidColorBrush x:Key="Bluestone.Warning" Color="{StaticResource Bluestone.WarningColor}" />
    <SolidColorBrush x:Key="Bluestone.Success" Color="{StaticResource Bluestone.SuccessColor}" />
    <SolidColorBrush x:Key="Bluestone.Cycle" Color="{StaticResource Bluestone.CycleColor}" />
    <SolidColorBrush x:Key="Bluestone.Mute" Color="{StaticResource Bluestone.MuteColor}" />
    <SolidColorBrush x:Key="Bluestone.Solo" Color="{StaticResource Bluestone.SoloColor}" />
    <SolidColorBrush x:Key="Bluestone.Lcd" Color="{StaticResource Bluestone.LcdColor}" />
    <SolidColorBrush x:Key="Bluestone.LcdText" Color="{StaticResource Bluestone.LcdTextColor}" />
    <SolidColorBrush x:Key="Bluestone.LcdLabel" Color="{StaticResource Bluestone.LcdLabelColor}" />

    <!-- The control bar and pane headers have a faint top-lit gradient, like hardware panels. -->
    <LinearGradientBrush x:Key="Bluestone.BarGradient" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#323235" />
      <GradientStop Offset="1" Color="#2A2A2D" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Bluestone.HeaderGradient" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#2E2E31" />
      <GradientStop Offset="1" Color="#28282B" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Bluestone.ButtonGradient" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#3E3E42" />
      <GradientStop Offset="1" Color="#363639" />
    </LinearGradientBrush>

    <FontFamily x:Key="Bluestone.MonoFont">SF Mono, Menlo, Cascadia Mono, JetBrains Mono, Consolas, DejaVu Sans Mono, monospace</FontFamily>
    <CornerRadius x:Key="Bluestone.PanelRadius">0</CornerRadius>
    <CornerRadius x:Key="Bluestone.ControlRadius">3</CornerRadius>

    <!-- Fluent's own sizes and radii, so combo boxes, fields, steppers, and flyouts match. -->
    <CornerRadius x:Key="ControlCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">4</CornerRadius>
    <x:Double x:Key="ControlContentThemeFontSize">12</x:Double>
    <Thickness x:Key="ComboBoxPadding">8,2,0,2</Thickness>
    <x:Double x:Key="TextControlThemeMinHeight">24</x:Double>
    <Thickness x:Key="TextControlThemePadding">6,3,6,3</Thickness>

    <!--
      Icons on a 16-unit grid. "Stroke" icons (outline style) use PathIcon.stroke; the rest are filled.
    -->
    <StreamGeometry x:Key="Icon.Play">M4.5,2.8 L13,8 L4.5,13.2 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Pause">M4,3 H6.6 V13 H4 Z M9.4,3 H12 V13 H9.4 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Stop">M3.5,3.5 H12.5 V12.5 H3.5 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Record">M8,3 A5,5 0 1 1 7.99,3 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Start">M3,3 H4.8 V13 H3 Z M13,3 L5.6,8 L13,13 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Rewind">M8,3.5 L1.8,8 L8,12.5 Z M14.2,3.5 L8,8 L14.2,12.5 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Forward">M8,3.5 L14.2,8 L8,12.5 Z M1.8,3.5 L8,8 L1.8,12.5 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Cycle">M2.5,9.5 V6.5 A2.5,2.5 0 0 1 5,4 H12.5 M10.5,2 L12.5,4 L10.5,6 M13.5,6.5 V9.5 A2.5,2.5 0 0 1 11,12 H3.5 M5.5,10 L3.5,12 L5.5,14</StreamGeometry>
    <StreamGeometry x:Key="Icon.Metronome">M4.5,13.5 L6.7,2.5 H9.3 L11.5,13.5 Z M8,10.5 L12,4 M5.4,9.5 H8.6</StreamGeometry>
    <StreamGeometry x:Key="Icon.Panic">M5.6,2 H10.4 L14,5.6 V10.4 L10.4,14 H5.6 L2,10.4 V5.6 Z M8,5 V8.6 M8,11 V11.1</StreamGeometry>
    <StreamGeometry x:Key="Icon.Undo">M6,3.5 L3,6.5 L6,9.5 M3.5,6.5 H10 A3,3 0 0 1 10,12.5 H7</StreamGeometry>
    <StreamGeometry x:Key="Icon.Redo">M10,3.5 L13,6.5 L10,9.5 M12.5,6.5 H6 A3,3 0 0 0 6,12.5 H9</StreamGeometry>
    <StreamGeometry x:Key="Icon.Inspector">M2.5,3 H13.5 V13 H2.5 Z M6.5,3 V13 M3.8,5.5 H5.2 M3.8,7.5 H5.2</StreamGeometry>
    <StreamGeometry x:Key="Icon.EditorPane">M2.5,3 H13.5 V13 H2.5 Z M2.5,8.5 H13.5 M4.5,10.5 H7 M8.5,11.2 H11.5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Arrow">M4,1.8 V13 L6.9,10.3 L8.8,14.3 L10.6,13.5 L8.7,9.6 L12.5,9.4 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Pencil">M10.5,2.5 L13.5,5.5 L5.5,13.5 H2.5 V10.5 Z M9,4 L12,7</StreamGeometry>
    <StreamGeometry x:Key="Icon.Eraser">M9.3,2.8 L13.2,6.7 L7,12.9 H4.2 L2.6,11.3 A1,1 0 0 1 2.6,9.9 Z M5.9,6.2 L9.8,10.1 M7,12.9 H13.5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Magnet">M3.5,2.5 V8 A4.5,4.5 0 0 0 12.5,8 V2.5 H10 V8 A2,2 0 0 1 6,8 V2.5 Z M3.5,5 H6 M10,5 H12.5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Piano">M2.5,3 H13.5 V13 H2.5 Z M5.2,9 V13 M8,9 V13 M10.8,9 V13 M4.6,3 V9 H5.8 V3 M7.4,3 V9 H8.6 V3 M10.2,3 V9 H11.4 V3</StreamGeometry>
    <StreamGeometry x:Key="Icon.PianoRoll">M2.5,2.5 V13.5 H13.5 M5,5 H8 M7,8 H11.5 M9.5,11 H13</StreamGeometry>
    <StreamGeometry x:Key="Icon.List">M5.5,4 H13.5 M5.5,8 H13.5 M5.5,12 H13.5 M2.5,4 H2.6 M2.5,8 H2.6 M2.5,12 H2.6</StreamGeometry>
    <StreamGeometry x:Key="Icon.Monitor">M1.5,8.5 H4.5 L6,4 L9,13 L10.5,8.5 H14.5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Messages">M2.5,3.5 H13.5 V10.5 H7 L4,13 V10.5 H2.5 Z M5,6 H11 M5,8 H9</StreamGeometry>
    <StreamGeometry x:Key="Icon.Plus">M8,3 V13 M3,8 H13</StreamGeometry>
    <StreamGeometry x:Key="Icon.Trash">M3,4.5 H13 M6.5,4.5 V2.8 H9.5 V4.5 M4.5,4.5 L5.2,13.2 H10.8 L11.5,4.5 M6.8,7 V11 M9.2,7 V11</StreamGeometry>
    <StreamGeometry x:Key="Icon.Duplicate">M5.5,5.5 H13 V13 H5.5 Z M3,10.5 V3 H10.5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Follow">M6,2.5 V13.5 M9,5.5 L12,8 L9,10.5 M6,8 H12</StreamGeometry>
    <StreamGeometry x:Key="Icon.ChevronDown">M4,6 L8,10 L12,6</StreamGeometry>
    <StreamGeometry x:Key="Icon.ChevronRight">M6,4 L10,8 L6,12</StreamGeometry>
    <StreamGeometry x:Key="Icon.MidiPort">M8,2 A6,6 0 1 1 7.99,2 Z M4.8,8.3 H4.9 M5.8,5.6 H5.9 M8,4.6 H8.1 M10.2,5.6 H10.3 M11.2,8.3 H11.3 M7,12 H9</StreamGeometry>
    <StreamGeometry x:Key="Icon.Quantize">M2.5,2.5 V13.5 M6.5,2.5 V13.5 M10.5,2.5 V13.5 M3.5,7 H6 M7.5,10 H10</StreamGeometry>
    <StreamGeometry x:Key="Icon.Velocity">M3,13.5 V9 M6.5,13.5 V5 M10,13.5 V7 M13.5,13.5 V3 M2.2,9 H3.8 M5.7,5 H7.3 M9.2,7 H10.8 M12.7,3 H14.3</StreamGeometry>
    <StreamGeometry x:Key="Icon.Keyboard">M1.5,4 H14.5 V12 H1.5 Z M3.8,6.3 H4 M6.2,6.3 H6.4 M8.6,6.3 H8.8 M11,6.3 H11.2 M5,8.3 H5.2 M7.4,8.3 H7.6 M9.8,8.3 H10 M12.2,8.3 H12.4 M5,10.2 H11</StreamGeometry>
    <StreamGeometry x:Key="Icon.ZoomIn">M7,2.5 A4.5,4.5 0 1 1 6.99,2.5 Z M10.3,10.3 L13.8,13.8 M4.8,7 H9.2 M7,4.8 V9.2</StreamGeometry>
    <StreamGeometry x:Key="Icon.ZoomOut">M7,2.5 A4.5,4.5 0 1 1 6.99,2.5 Z M10.3,10.3 L13.8,13.8 M4.8,7 H9.2</StreamGeometry>
    <StreamGeometry x:Key="Icon.Logo">M1,9 H4 V15 H1 Z M6,5 H9 V15 H6 Z M11,1 H14 V15 H11 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Check">M2,8 L6,12 L14,4 L12.6,2.6 L6,9.2 L3.4,6.6 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Warning">M8,1 L15,14 H1 Z M7.2,5 V10 H8.8 V5 Z M7.2,11 V12.6 H8.8 V11 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Offline">M8,1 A7,7 0 1 1 7.99,1 Z M5,4 L4,5 L11,12 L12,11 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Dot">M8,5 A3,3 0 1 1 7.99,5 Z</StreamGeometry>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource Bluestone.Base}" />
    <Setter Property="Foreground" Value="{StaticResource Bluestone.Text}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Surfaces: panes are flush and separated by dark hairlines, not floating cards. -->
  <Style Selector="Border.pane">
    <Setter Property="Background" Value="{StaticResource Bluestone.Panel}" />
  </Style>
  <Style Selector="Border.bar">
    <Setter Property="Background" Value="{StaticResource Bluestone.BarGradient}" />
    <Setter Property="BorderBrush" Value="{StaticResource Bluestone.Divider}" />
  </Style>
  <Style Selector="Border.header">
    <Setter Property="Background" Value="{StaticResource Bluestone.HeaderGradient}" />
    <Setter Property="BorderBrush" Value="{StaticResource Bluestone.Divider}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.hairline">
    <Setter Property="Background" Value="{StaticResource Bluestone.Divider}" />
  </Style>
  <Style Selector="Border.separator">
    <Setter Property="Background" Value="{StaticResource Bluestone.Border}" />
    <Setter Property="Width" Value="1" />
    <Setter Property="Margin" Value="6,4" />
  </Style>
  <Style Selector="GridSplitter.hairline">
    <Setter Property="Background" Value="{StaticResource Bluestone.Divider}" />
    <Setter Property="MinWidth" Value="1" />
    <Setter Property="MinHeight" Value="1" />
  </Style>

  <!-- Type -->
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.overline">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Foreground" Value="{StaticResource Bluestone.TextMuted}" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{StaticResource Bluestone.TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource Bluestone.TextMuted}" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="Foreground" Value="{StaticResource Bluestone.TextSecondary}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Compact Fluent controls -->
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="8,2,0,2" />
    <Setter Property="Background" Value="{StaticResource Bluestone.ButtonGradient}" />
    <Setter Property="BorderBrush" Value="#19191B" />
  </Style>
  <Style Selector="ComboBox.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="NumericUpDown">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="NumericUpDown.compact">
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="Background" Value="#1A1A1D" />
    <Setter Property="BorderBrush" Value="#111113" />
    <Setter Property="FontFamily" Value="{StaticResource Bluestone.MonoFont}" />
  </Style>
  <Style Selector="NumericUpDown.compact /template/ TextBox">
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="24" />
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Background" Value="#3A3A3E" />
    <Setter Property="Foreground" Value="{StaticResource Bluestone.Text}" />
    <Setter Property="BorderBrush" Value="#19191B" />
    <Setter Property="Padding" Value="7,4" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Button, ToggleButton">
    <Setter Property="CornerRadius" Value="{StaticResource Bluestone.ControlRadius}" />
    <Setter Property="Padding" Value="9,3" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="24" />
  </Style>
  <Style Selector="Button.raised">
    <Setter Property="Background" Value="{StaticResource Bluestone.ButtonGradient}" />
    <Setter Property="BorderBrush" Value="#19191B" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.raised:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Bluestone.Pressed}" />
  </Style>
  <Style Selector="Button.ghost, DropDownButton.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource Bluestone.TextSecondary}" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Bluestone.Hover}" />
    <Setter Property="Foreground" Value="{StaticResource Bluestone.Text}" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,2" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource Bluestone.AccentHover}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#8CB8EC" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource Bluestone.Accent}" />
    <Setter Property="Foreground" Value="{StaticResource Bluestone.OnAccent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Bluestone.AccentHover}" />
    <Setter Property="Foreground" Value="{StaticResource Bluestone.OnAccent}" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="#6B2C2F" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="#E8797C" />
  </Style>

  <!--
    Tool buttons: square, icon-only, used in the control bar and pane headers. Checked tool buttons
    light up in the accent (or a semantic colour via .cycle, .record, .play).
  -->
  <Style Selector="Button.tool, ToggleButton.tool">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="24" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource Bluestone.TextSecondary}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.tool:pointerover /template/ ContentPresenter, ToggleButton.tool:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Bluestone.Hover}" />
  </Style>
  <Style Selector="Button.tool:pointerover, ToggleButton.tool:pointerover">
    <Setter Property="Foreground" Value="{StaticResource Bluestone.Text}" />
  </Style>
  <Style Selector="Button.tool:pressed /template/ ContentPresenter, ToggleButton.tool:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Bluestone.Pressed}" />
  </Style>
  <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="#24384F" />
  </Style>
  <Style Selector="ToggleButton.tool:checked">
    <Setter Property="Foreground" Value="#7DB2EE" />
  </Style>
  <Style Selector="Button.tool:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.tool:disabled PathIcon">
    <Setter Property="Opacity" Value="0.35" />
  </Style>

  <!-- Transport: a segmented strip of raised buttons. -->
  <Style Selector="Border.transport">
    <Setter Property="Background" Value="#19191B" />
    <Setter Property="BorderBrush" Value="#111113" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="1" />
  </Style>
  <Style Selector="Border.transport > StackPanel > :is(Button)">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="{StaticResource Bluestone.ButtonGradient}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="#C9C9CD" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.transport > StackPanel > :is(Button):pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#47474C" />
  </Style>
  <Style Selector="Border.transport > StackPanel > :is(Button):pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#2C2C2F" />
  </Style>
  <Style Selector="Border.transport ToggleButton.play:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="#2F5E3E" />
  </Style>
  <Style Selector="Border.transport ToggleButton.play:checked">
    <Setter Property="Foreground" Value="#7EE09D" />
  </Style>
  <Style Selector="Border.transport ToggleButton.record">
    <Setter Property="Foreground" Value="#C0585B" />
  </Style>
  <Style Selector="Border.transport ToggleButton.record:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="#6A2427" />
  </Style>
  <Style Selector="Border.transport ToggleButton.record:checked">
    <Setter Property="Foreground" Value="#FF6B6F" />
  </Style>
  <Style Selector="Border.transport ToggleButton.cycle:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="#5A4A16" />
  </Style>
  <Style Selector="Border.transport ToggleButton.cycle:checked">
    <Setter Property="Foreground" Value="#F2CF5B" />
  </Style>
  <Style Selector="Border.transport ToggleButton.mode:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="#24384F" />
  </Style>
  <Style Selector="Border.transport ToggleButton.mode:checked">
    <Setter Property="Foreground" Value="#8CBDF2" />
  </Style>

  <!-- Computer keyboard: an accent-lit toggle with a slide-out LCD readout of octave and velocity. -->
  <Style Selector="Border.transport ToggleButton.keys:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="#1F4A5A" />
    <Setter Property="BoxShadow" Value="0 0 8 0 #666FD8F2" />
  </Style>
  <Style Selector="Border.transport ToggleButton.keys:checked">
    <Setter Property="Foreground" Value="#6FD8F2" />
  </Style>
  <Style Selector="Border.keysReadout">
    <Setter Property="Background" Value="{StaticResource Bluestone.Lcd}" />
    <Setter Property="BorderBrush" Value="#2A5563" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="Height" Value="30" />
    <Setter Property="BoxShadow" Value="inset 0 1 3 0 #90000000" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="RenderTransform" Value="translateX(-6px)" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.keysReadout.on">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="IsHitTestVisible" Value="True" />
    <Setter Property="RenderTransform" Value="translateX(0px)" />
  </Style>
  <Style Selector="TextBlock.keysValue">
    <Setter Property="FontFamily" Value="{StaticResource Bluestone.MonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="#6FD8F2" />
  </Style>
  <Style Selector="ProgressBar.keysMeter">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="3" />
    <Setter Property="CornerRadius" Value="1.5" />
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="1" />
    <Setter Property="Background" Value="#22343A" />
    <Setter Property="Foreground" Value="#6FD8F2" />
  </Style>
  <Style Selector="Ellipse.keysActivity">
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="Fill" Value="#22343A" />
  </Style>
  <Style Selector="Ellipse.keysActivity.on">
    <Setter Property="Fill" Value="#6FD8F2" />
  </Style>

  <!-- The LCD: a recessed display of position, time, tempo, and meter. -->
  <Style Selector="Border.lcd">
    <Setter Property="Background" Value="{StaticResource Bluestone.Lcd}" />
    <Setter Property="BorderBrush" Value="#0B0B0C" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BoxShadow" Value="inset 0 1 3 0 #90000000" />
  </Style>
  <Style Selector="TextBlock.lcd">
    <Setter Property="FontFamily" Value="{StaticResource Bluestone.MonoFont}" />
    <Setter Property="Foreground" Value="{StaticResource Bluestone.LcdText}" />
  </Style>
  <Style Selector="TextBlock.lcdLabel">
    <Setter Property="FontSize" Value="8.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.8" />
    <Setter Property="Foreground" Value="{StaticResource Bluestone.LcdLabel}" />
  </Style>
  <Style Selector="TextBox.lcd">
    <Setter Property="FontFamily" Value="{StaticResource Bluestone.MonoFont}" />
    <Setter Property="Foreground" Value="{StaticResource Bluestone.LcdText}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="CaretBrush" Value="{StaticResource Bluestone.LcdText}" />
  </Style>
  <Style Selector="TextBox.lcd:pointerover /template/ Border#PART_BorderElement, TextBox.lcd:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="#24242A" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="PathIcon.stroke">
    <Setter Property="Template">
      <ControlTemplate>
        <Viewbox Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
          <Path Data="{TemplateBinding Data}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.35"
                StrokeLineCap="Round" StrokeJoin="Round" Width="16" Height="16" />
        </Viewbox>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="PathIcon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>

  <!-- Track header buttons: automation, Mute, Solo, Record arm. Letters or icons plus colour; names for screen readers. -->
  <Style Selector="ToggleButton.trackButton, Button.trackButton">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="17" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{StaticResource Bluestone.ButtonGradient}" />
    <Setter Property="BorderBrush" Value="#19191B" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="#9A9AA0" />
  </Style>
  <Style Selector="ToggleButton.trackButton:pointerover /template/ ContentPresenter, Button.trackButton:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#47474C" />
  </Style>
  <Style Selector="ToggleButton.trackButton.mute:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Bluestone.Mute}" />
  </Style>
  <Style Selector="ToggleButton.trackButton.mute:checked">
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="ToggleButton.trackButton.solo:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Bluestone.Solo}" />
  </Style>
  <Style Selector="ToggleButton.trackButton.solo:checked">
    <Setter Property="Foreground" Value="#2A2300" />
  </Style>
  <Style Selector="ToggleButton.trackButton.arm">
    <Setter Property="Foreground" Value="#A0585A" />
  </Style>
  <Style Selector="ToggleButton.trackButton.arm:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Bluestone.Danger}" />
  </Style>
  <Style Selector="ToggleButton.trackButton.arm:checked">
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <!-- Status chips -->
  <Style Selector="Border.chip">
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Padding" Value="5,1" />
    <Setter Property="Background" Value="{StaticResource Bluestone.Raised}" />
  </Style>

  <!-- Lower pane tabs -->
  <Style Selector="RadioButton.tab">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Tab" Background="Transparent" Padding="10,0" BorderThickness="0,0,0,2" BorderBrush="Transparent">
          <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="Foreground" Value="{StaticResource Bluestone.TextSecondary}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="RadioButton.tab:pointerover">
    <Setter Property="Foreground" Value="{StaticResource Bluestone.Text}" />
  </Style>
  <Style Selector="RadioButton.tab:checked /template/ Border#PART_Tab">
    <Setter Property="BorderBrush" Value="{StaticResource Bluestone.Accent}" />
    <Setter Property="Background" Value="#2A2B2F" />
  </Style>
  <Style Selector="RadioButton.tab:checked">
    <Setter Property="Foreground" Value="{StaticResource Bluestone.Text}" />
  </Style>
  <Style Selector="RadioButton.tab:focus-visible /template/ Border#PART_Tab">
    <Setter Property="Background" Value="#33343A" />
  </Style>

  <!-- Inspector sections -->
  <Style Selector="Expander.section">
    <Setter Property="Padding" Value="10,6,10,10" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Expander.section /template/ ToggleButton#ExpanderHeader">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="{StaticResource Bluestone.HeaderGradient}" />
    <Setter Property="BorderBrush" Value="{StaticResource Bluestone.Divider}" />
    <Setter Property="BorderThickness" Value="0,1,0,1" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Expander.section /template/ Border#ExpanderContent">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <!-- Dense lists (messages, monitor, event list) -->
  <Style Selector="ListBox.dense">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.dense ListBoxItem">
    <Setter Property="Padding" Value="10,1" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="ListBox.grid ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="22" />
  </Style>
  <Style Selector="ListBox.grid ListBoxItem:nth-child(2n)">
    <Setter Property="Background" Value="#28282B" />
  </Style>
  <Style Selector="ListBox.grid ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="#2D4766" />
  </Style>
  <Style Selector="TextBox.cell">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="22" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{StaticResource Bluestone.MonoFont}" />
    <Setter Property="FontSize" Value="11.5" />
  </Style>
  <Style Selector="TextBox.cell:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="#303035" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.cell:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="#1A1A1D" />
    <Setter Property="BorderBrush" Value="{StaticResource Bluestone.Accent}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBox.field">
    <Setter Property="Background" Value="#1A1A1D" />
    <Setter Property="BorderBrush" Value="#111113" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{StaticResource Bluestone.MonoFont}" />
    <Setter Property="FontSize" Value="11.5" />
  </Style>

  <!-- Track list rows -->
  <Style Selector="ListBox.tracks">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.tracks ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Height" Value="50" />
    <Setter Property="Background" Value="#262628" />
    <Setter Property="BorderBrush" Value="#19191B" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="ListBox.tracks ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#2C2C2F" />
  </Style>
  <Style Selector="ListBox.tracks ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="#35373D" />
  </Style>
  <Style Selector="TextBox.inline">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBox.clipName">
    <Setter Property="Padding" Value="3,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="1.5" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.inline:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource Bluestone.Base}" />
  </Style>

  <!-- Keep keyboard focus clearly visible on every restyled control. -->
  <Style Selector=":is(Button):focus-visible /template/ ContentPresenter, ToggleButton:focus-visible /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource Bluestone.AccentHover}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
</Styles>
