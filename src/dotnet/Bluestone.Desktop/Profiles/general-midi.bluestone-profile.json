  "sysex": [
    {
      "id": "gm-system-on",
      "name": "GM System On",
      "effect": "reset",
      "description": "Resets a General MIDI instrument to its GM default state.",
      "bytes": "F0 7E {device} 09 01 F7",
      "parameters": [
        {
          "name": "device",
          "min": 0,
          "max": 127,
          "default": 127
        }
      ]
    },
    {
      "id": "master-volume",
      "name": "Master Volume",
      "effect": "parameter",
      "description": "Universal real-time master volume (14-bit, LSB then MSB).",
      "bytes": "F0 7F {device} 04 01 {lsb} {msb} F7",
      "parameters": [
        {
          "name": "device",
          "min": 0,
          "max": 127,
          "default": 127
        },
        {
          "name": "lsb",
          "min": 0,
          "max": 127,
          "default": 127
        },
        {
          "name": "msb",
          "min": 0,
          "max": 127,
          "default": 127
        }
      ]
    }
  ],
  "initialization": [
    {
      "sysex": "gm-system-on",
      "delayAfterMs": 100
    }
  ],
  "limitations": [
    "Program names are the GM standard; a particular instrument's own voice names may differ.",
    "Pitch bend sensitivity values are the raw 14-bit RPN value: MSB is semitones, LSB is cents (default 2 semitones = 256)."
  ]
}
