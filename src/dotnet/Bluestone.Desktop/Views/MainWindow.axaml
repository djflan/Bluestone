<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bluestone.Presentation"
        xmlns:controls="using:Bluestone.Desktop.Controls"
        xmlns:theme="using:Bluestone.Desktop.Theme"
        xmlns:views="using:Bluestone.Desktop.Views"
        x:Class="Bluestone.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Width="1440" Height="900" MinWidth="1040" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">
  <Window.DataTemplates>
    <DataTemplate DataType="vm:DeviceViewViewModel">
      <views:DeviceViewControl />
    </DataTemplate>
  </Window.DataTemplates>
  <Window.Resources>
    <!-- A collapsed or detached view on a border rail: an icon and its name running up the rail. Click to open it docked. -->
    <DataTemplate x:Key="RailItem" x:DataType="vm:WorkspaceView">
      <Button Classes="railItem" Classes.open="{Binding IsDocked}" Classes.detached="{Binding IsDetached}" Classes.awaiting="{Binding IsAwaitingDisplay}"
              Command="{Binding ToggleCommand}" ToolTip.Tip="{Binding Title}" AutomationProperties.Name="{Binding RailLabel}">
        <StackPanel Spacing="8">
          <PathIcon Classes="stroke" Data="{Binding Kind, Converter={x:Static theme:WorkspaceIconConverter.Instance}}" />
          <LayoutTransformControl>
            <LayoutTransformControl.LayoutTransform>
              <RotateTransform Angle="-90" />
            </LayoutTransformControl.LayoutTransform>
            <TextBlock Text="{Binding RailLabel}" />
          </LayoutTransformControl>
        </StackPanel>
        <Button.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Dock" Command="{Binding DockCommand}" />
            <MenuItem Header="Detach to Window" Command="{Binding DetachCommand}" IsVisible="{Binding CanDetach}" />
            <MenuItem Header="Close" Command="{Binding CloseCommand}" IsVisible="{Binding CanClose}" />
          </ContextMenu>
        </Button.ContextMenu>
      </Button>
    </DataTemplate>
  </Window.Resources>
  <Panel>
  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Control bar: view toggles and undo on the left, transport and LCD in the centre, panic on the right. -->
    <Border Grid.Row="0" Classes="bar" BorderThickness="0,0,0,1" Height="50">
      <Grid ColumnDefinitions="*,Auto,*" Margin="8,0">
        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <ToggleButton Classes="tool" IsChecked="{Binding IsInspectorVisible}" ToolTip.Tip="Show or hide the inspector (I)" AutomationProperties.Name="Inspector">
            <PathIcon Classes="stroke" Data="{StaticResource Icon.Inspector}" />
          </ToggleButton>
          <ToggleButton Classes="tool" IsChecked="{Binding Workspace.Browser.IsDocked, Mode=OneWay}" Command="{Binding Workspace.Browser.ToggleCommand}"
                        ToolTip.Tip="Show or hide the Browser (B)" AutomationProperties.Name="Browser">
            <PathIcon Classes="stroke" Data="{StaticResource Icon.Browser}" />
          </ToggleButton>
          <ToggleButton Classes="tool" IsChecked="{Binding IsEditorVisible}" ToolTip.Tip="Show or hide the detail region: devices and editors (P: piano roll, D: event list)" AutomationProperties.Name="Editors">
            <PathIcon Classes="stroke" Data="{StaticResource Icon.EditorPane}" />
          </ToggleButton>
          <Border Classes="separator" Height="18" />
          <Button Classes="tool" Command="{Binding UndoCommand}" ToolTip.Tip="Undo (Ctrl/Cmd+Z)" AutomationProperties.Name="Undo">
            <PathIcon Classes="stroke" Data="{StaticResource Icon.Undo}" />
          </Button>
          <Button Classes="tool" Command="{Binding RedoCommand}" ToolTip.Tip="Redo (Ctrl/Cmd+Shift+Z)" AutomationProperties.Name="Redo">
            <PathIcon Classes="stroke" Data="{StaticResource Icon.Redo}" />
          </Button>
          <DropDownButton x:Name="FileMenuButton" Classes="ghost" Content="File" Margin="6,0,0,0" FontSize="12" AutomationProperties.Name="File menu">
            <DropDownButton.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="New Project" Command="{Binding NewProjectCommand}" InputGesture="Ctrl+N" />
                <MenuItem Header="Open…" Command="{Binding OpenCommand}" InputGesture="Ctrl+O" />
                <Separator />
                <MenuItem Header="Save" Command="{Binding SaveCommand}" InputGesture="Ctrl+S" />
                <MenuItem Header="Save As…" Command="{Binding SaveAsCommand}" InputGesture="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="Import MIDI File…" Command="{Binding ImportMidiCommand}" InputGesture="Ctrl+I" />
                <MenuItem Header="Export MIDI File…" Command="{Binding ExportMidiCommand}" InputGesture="Ctrl+E" />
                <Separator />
                <MenuItem Header="Mixer…" Click="OnShowMixer" ToolTip.Tip="The mixer console: strips, sends, and meters" />
                <MenuItem Header="Plugins…" Click="OnShowPlugins" ToolTip.Tip="Scanned plugins, how they share worker processes, modules that could not be read, and quarantined modules" />
                <MenuItem Header="Audio Settings…" Click="OnAudioSettingsClick" />
              </MenuFlyout>
            </DropDownButton.Flyout>
          </DropDownButton>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Classes="transport">
            <StackPanel Orientation="Horizontal" Spacing="1">
              <Button Command="{Binding ReturnToStartCommand}" ToolTip.Tip="Go to start (Home)" AutomationProperties.Name="Go to start">
                <PathIcon Data="{StaticResource Icon.Start}" Width="12" Height="12" />
              </Button>
              <Button Command="{Binding PreviousBarCommand}" ToolTip.Tip="Back one bar (,)" AutomationProperties.Name="Rewind one bar">
                <PathIcon Data="{StaticResource Icon.Rewind}" Width="14" Height="14" />
              </Button>
              <Button Command="{Binding NextBarCommand}" ToolTip.Tip="Forward one bar (.)" AutomationProperties.Name="Forward one bar">
                <PathIcon Data="{StaticResource Icon.Forward}" Width="14" Height="14" />
              </Button>
              <Button Command="{Binding StopCommand}" ToolTip.Tip="Stop; press again to go to the start" AutomationProperties.Name="Stop">
                <PathIcon Data="{StaticResource Icon.Stop}" Width="11" Height="11" />
              </Button>
              <ToggleButton Classes="play" IsChecked="{Binding IsPlaying, Mode=OneWay}" Command="{Binding PlayPauseCommand}" ToolTip.Tip="Play or stop (Space)" AutomationProperties.Name="{Binding PlayButtonText}">
                <PathIcon Data="{StaticResource Icon.Play}" Width="13" Height="13" />
              </ToggleButton>
              <ToggleButton Classes="record" IsChecked="{Binding IsRecording, Mode=OneWay}" Command="{Binding RecordCommand}" ToolTip.Tip="Record into the armed or selected track (R)" AutomationProperties.Name="Record">
                <PathIcon Data="{StaticResource Icon.Record}" Width="12" Height="12" />
              </ToggleButton>
            </StackPanel>
          </Border>
          <Border Classes="transport">
            <StackPanel Orientation="Horizontal" Spacing="1">
              <ToggleButton Classes="cycle" IsChecked="{Binding IsLoopEnabled, Mode=OneWay}" Command="{Binding ToggleLoopCommand}" ToolTip.Tip="Cycle: loop four bars from the playhead (L), or drag in the ruler" AutomationProperties.Name="Cycle">
                <PathIcon Classes="stroke" Data="{StaticResource Icon.Cycle}" Width="15" Height="15" />
              </ToggleButton>
            </StackPanel>
          </Border>

          <!-- LCD -->
          <Border Classes="lcd" Height="40" Padding="12,2">
            <StackPanel Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
              <StackPanel VerticalAlignment="Center" Spacing="0">
                <TextBlock Text="{Binding PositionText}" Classes="lcd" FontSize="19" FontWeight="Medium" MinWidth="118" AutomationProperties.Name="Position in bars, beats, and ticks" />
                <TextBlock Text="BAR  BEAT  TICK" Classes="lcdLabel" />
              </StackPanel>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding TimeText}" Classes="lcd" FontSize="13" MinWidth="84" Margin="0,3,0,2" AutomationProperties.Name="Elapsed time" />
                <TextBlock Text="TIME" Classes="lcdLabel" />
              </StackPanel>
              <Border Width="1" Background="{StaticResource Lcd.Rule}" Margin="0,4" />
              <StackPanel VerticalAlignment="Center">
                <TextBox x:Name="TempoBox" Classes="lcd" Text="{Binding TempoText, Mode=OneWay}" FontSize="15" Width="56" Margin="0,1,0,1"
                         ToolTip.Tip="Tempo in BPM. Click to type a new tempo." AutomationProperties.Name="Tempo" />
                <TextBlock Text="TEMPO" Classes="lcdLabel" />
              </StackPanel>
              <StackPanel VerticalAlignment="Center">
                <TextBox x:Name="MeterBox" Classes="lcd" Text="{Binding MeterText, Mode=OneWay}" FontSize="15" Width="40" Margin="0,1,0,1"
                         ToolTip.Tip="Time signature. Click to type, e.g. 3/4." AutomationProperties.Name="Time signature" />
                <TextBlock Text="SIGNATURE" Classes="lcdLabel" />
              </StackPanel>
              <Border Width="1" Background="{StaticResource Lcd.Rule}" Margin="0,4" />
              <StackPanel VerticalAlignment="Center" Spacing="3" ToolTip.Tip="MIDI input activity">
                <Ellipse Width="7" Height="7" HorizontalAlignment="Center" Fill="{StaticResource Transport.InputIdle}" IsVisible="{Binding !HasInputActivity}" />
                <Ellipse Width="7" Height="7" HorizontalAlignment="Center" Fill="{StaticResource Transport.InputActive}" IsVisible="{Binding HasInputActivity}" />
                <TextBlock Text="IN" Classes="lcdLabel" HorizontalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="transport">
            <StackPanel Orientation="Horizontal" Spacing="1">
              <ToggleButton Classes="mode" IsChecked="{Binding IsCountInEnabled, Mode=OneWay}" Command="{Binding ToggleCountInCommand}" ToolTip.Tip="Count in before recording" AutomationProperties.Name="Count-in">
                <TextBlock Text="1234" FontSize="9.5" FontWeight="Bold" LetterSpacing="-0.3" />
              </ToggleButton>
              <ToggleButton Classes="mode" IsChecked="{Binding IsMetronomeEnabled, Mode=OneWay}" Command="{Binding ToggleMetronomeCommand}" ToolTip.Tip="Metronome click (K)" AutomationProperties.Name="Metronome">
                <PathIcon Classes="stroke" Data="{StaticResource Icon.Metronome}" Width="15" Height="15" />
              </ToggleButton>
            </StackPanel>
          </Border>

          <!-- Computer keyboard: play and record notes from the keyboard. -->
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                      DataContext="{Binding Keyboard}" x:DataType="vm:ComputerKeyboardViewModel"
                      IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Border Classes="transport">
              <StackPanel Orientation="Horizontal" Spacing="1">
                <ToggleButton Classes="keys" IsChecked="{Binding IsEnabled, Mode=OneWay}" Command="{Binding ToggleCommand}"
                              ToolTip.Tip="Computer keyboard (`): play notes with A–' (white) and W E T Y U O P (black). Z/X octave, C/V velocity."
                              AutomationProperties.Name="Computer keyboard">
                  <PathIcon Classes="stroke" Data="{StaticResource Icon.Keyboard}" Width="16" Height="16" />
                </ToggleButton>
              </StackPanel>
            </Border>
            <Border Classes="keysReadout" Classes.on="{Binding IsEnabled}" AutomationProperties.Name="Computer keyboard octave and velocity">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Ellipse Classes="keysActivity" Classes.on="{Binding IsSounding}" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center" ToolTip.Tip="MIDI channel of the armed or selected track">
                  <TextBlock Text="{Binding ChannelText}" Classes="keysValue" MinWidth="14" />
                  <TextBlock Text="CH" Classes="lcdLabel" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center" ToolTip.Tip="Octave of the A key (Z/X)">
                  <TextBlock Text="{Binding OctaveText}" Classes="keysValue" MinWidth="26" />
                  <TextBlock Text="OCT" Classes="lcdLabel" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Spacing="2" ToolTip.Tip="Velocity (C/V)">
                  <TextBlock Text="{Binding VelocityText}" Classes="keysValue" />
                  <ProgressBar Classes="keysMeter" Value="{Binding VelocityFraction}" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center" MinWidth="30">
                  <TextBlock Text="{Binding LastNoteText}" Classes="keysValue" Foreground="{StaticResource Lcd.Text}" />
                  <TextBlock Text="NOTE" Classes="lcdLabel" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2" VerticalAlignment="Center">
          <Button Classes="tool" Command="{Binding PanicCommand}" ToolTip.Tip="Panic: silence every output (Ctrl/Cmd+.)" AutomationProperties.Name="Panic, silence all outputs">
            <PathIcon Classes="stroke" Data="{StaticResource Icon.Panic}" Foreground="{StaticResource Control.Panic}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!--
      Workspace (ADR 0036): border rails for collapsed views, the inspector's region on the left, the Browser's on the right,
      and the arranger over the detail region (Device Views and editors) in the middle. Docked tools push the rest aside.
    -->
    <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto,Auto">

      <Border x:Name="LeftRail" Grid.Column="0" Classes="rail left" IsVisible="{Binding Workspace.LeftRail.Count}">
        <ItemsControl ItemsSource="{Binding Workspace.LeftRail}" ItemTemplate="{StaticResource RailItem}" />
      </Border>

      <!-- Inspector -->
      <Panel x:Name="InspectorDock" Grid.Column="1" Width="{Binding Workspace.LeftExtent}" IsVisible="{Binding IsInspectorVisible}" ZIndex="1">
      <Border Classes="pane" BorderBrush="{StaticResource Line.Divider}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*">
        <Border Classes="dockHeader">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="dockTitle" Text="INSPECTOR" />
            <Button Grid.Column="1" Classes="tool small" Command="{Binding Workspace.Inspector.CollapseCommand}" ToolTip.Tip="Collapse to the rail (I)" AutomationProperties.Name="Collapse inspector">
              <PathIcon Classes="stroke" Data="{StaticResource Icon.ChevronLeft}" />
            </Button>
          </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Padding="10,10,10,10" IsVisible="{Binding !Selection.HasSelection}">
              <TextBlock Text="Select a track to set its output, instrument, and voice. Shift-click or ⌘/Ctrl-click to select several." Classes="muted" TextWrapping="Wrap" />
            </Border>

            <StackPanel DataContext="{Binding Selection}" x:DataType="vm:SelectionViewModel" IsVisible="{Binding HasSelection}">
              <Grid ColumnDefinitions="Auto,*" Margin="10,10,10,8">
                <Border Width="4" CornerRadius="1" Margin="0,1,8,1"
                        Background="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectedTrack.ColorIndex, Converter={x:Static theme:TrackBrushConverter.Instance}, FallbackValue={x:Null}}" />
                <StackPanel Grid.Column="1" Spacing="1">
                  <TextBlock Text="{Binding Title}" Classes="title" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Subtitle}" Classes="muted" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Subtitle}" />
                </StackPanel>
              </Grid>

              <Expander Classes="section" Header="Track" IsExpanded="True">
                <Grid ColumnDefinitions="64,*" RowSpacing="6">
                  <TextBlock Text="Role" Classes="label" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding RoleChoices}" SelectedItem="{Binding Role}" PlaceholderText="Mixed" HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Track role"
                            ToolTip.Tip="What the track is for. Changing it never removes clips, devices, automation, or routing; Bluestone asks or refuses when it would." />
                </Grid>
              </Expander>

              <Expander Classes="section" Header="Routing" IsExpanded="True">
                <Grid ColumnDefinitions="64,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                  <TextBlock Text="Output" Classes="label" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding OutputChoices}" SelectedItem="{Binding Output}" HorizontalAlignment="Stretch" AutomationProperties.Name="MIDI output"
                            ToolTip.Tip="Where the messages go: a hardware port, virtual bus, or the built-in monitor.">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:OutputOption">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Detail}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Grid.Row="1" Text="Instrument" Classes="label" />
                  <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ProfileChoices}" SelectedItem="{Binding Profile}" HorizontalAlignment="Stretch" AutomationProperties.Name="Instrument profile"
                            ToolTip.Tip="What the instrument understands: voices, controllers, setup messages." />
                  <TextBlock Grid.Row="2" Text="Channel" Classes="label" />
                  <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding ChannelChoices}" SelectedItem="{Binding Channel}" HorizontalAlignment="Stretch" AutomationProperties.Name="Channel" />
                  <TextBlock Grid.Row="3" Text="Transpose" Classes="label" />
                  <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Transpose}" Minimum="-48" Maximum="48" Increment="1" FormatString="+0;-0;0"
                                 PlaceholderText="Mixed" AutomationProperties.Name="Transpose in semitones" />
                  <Button Grid.Row="4" Grid.Column="1" Classes="link" Content="Use this output for all tracks" HorizontalAlignment="Left"
                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).UseOutputForAllTracksCommand}" />
                </Grid>
              </Expander>

              <Expander Classes="section" Header="Voice" IsExpanded="True">
                <StackPanel Spacing="6">
                  <ComboBox ItemsSource="{Binding Banks}" SelectedItem="{Binding VoiceBank}" HorizontalAlignment="Stretch" IsVisible="{Binding CanEditVoice}" AutomationProperties.Name="Voice bank" />
                  <ComboBox ItemsSource="{Binding Programs}" SelectedItem="{Binding VoiceProgram}" HorizontalAlignment="Stretch" IsVisible="{Binding CanEditVoice}" IsEnabled="{Binding Programs.Count}"
                            AutomationProperties.Name="Voice program" MaxDropDownHeight="360" />
                  <TextBlock Text="{Binding VoiceHint}" Classes="muted" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding ProfileNotices}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}" Classes="muted" TextWrapping="Wrap" FontSize="10" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Classes="raised" Content="Initialize Instrument…" IsEnabled="{Binding CanInitialize}" IsVisible="{Binding IsSingle}" HorizontalAlignment="Stretch"
                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).InitializeInstrumentCommand}"
                          ToolTip.Tip="Send the profile's setup messages, asking before anything that resets the instrument" />
                </StackPanel>
              </Expander>

              <ItemsControl ItemsSource="{Binding Problems}" Margin="10,8,10,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,6">
                      <PathIcon Data="{StaticResource Icon.Warning}" Width="11" Height="11" Foreground="{StaticResource State.Warning}" VerticalAlignment="Top" Margin="0,2,6,0" />
                      <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" Classes="muted" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <Expander x:Name="AudioClipSection" Classes="section" Header="Audio Clip" IsExpanded="True" DataContext="{Binding AudioClip}" x:DataType="vm:AudioClipViewModel" IsVisible="{Binding HasClip}">
              <Grid ColumnDefinitions="64,*,64" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="4">
                <TextBlock Grid.ColumnSpan="3" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="1" Text="Gain" Classes="label" VerticalAlignment="Center" />
                <Slider Grid.Row="1" Grid.Column="1" Minimum="{Binding MinimumGain}" Maximum="{Binding MaximumGain}" Value="{Binding Gain}" SmallChange="0.5" LargeChange="3" AutomationProperties.Name="Clip gain" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding GainText}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" />
                <TextBlock Grid.Row="2" Text="Fade in" Classes="label" VerticalAlignment="Center" />
                <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="{Binding MaximumFade}" Value="{Binding FadeIn}" SmallChange="0.25" LargeChange="1" AutomationProperties.Name="Fade-in length" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding FadeInText}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" />
                <TextBlock Grid.Row="3" Text="Fade out" Classes="label" VerticalAlignment="Center" />
                <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="{Binding MaximumFade}" Value="{Binding FadeOut}" SmallChange="0.25" LargeChange="1" AutomationProperties.Name="Fade-out length" />
                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding FadeOutText}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" />
                <CheckBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Content="Equal-power fades" IsChecked="{Binding IsEqualPower}" AutomationProperties.Name="Equal-power fades"
                          ToolTip.Tip="Quarter-sine curves (−3 dB half way) instead of straight lines (−6 dB half way)" />
              </Grid>
            </Expander>

            <Expander x:Name="ConnectionsSection" Classes="section" Header="Connections" IsExpanded="False" DataContext="{Binding Connections}" x:DataType="vm:ConnectionsViewModel" IsVisible="{Binding HasTrack}">
              <StackPanel Spacing="6">
                <TextBlock Text="Sends" Classes="label" />
                <ItemsControl ItemsSource="{Binding Outgoing}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConnectionRow">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,3">
                        <StackPanel>
                          <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="tool" Content="✕" VerticalAlignment="Top" AutomationProperties.Name="Disconnect"
                                Command="{Binding $parent[ItemsControl].((vm:ConnectionsViewModel)DataContext).DisconnectCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Receives" Classes="label" />
                <ItemsControl ItemsSource="{Binding Incoming}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConnectionRow">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,3">
                        <StackPanel>
                          <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="tool" Content="✕" VerticalAlignment="Top" AutomationProperties.Name="Disconnect"
                                Command="{Binding $parent[ItemsControl].((vm:ConnectionsViewModel)DataContext).DisconnectCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="New connection" Classes="label" />
                <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" HorizontalAlignment="Stretch" AutomationProperties.Name="Connection source" />
                <ComboBox ItemsSource="{Binding Destinations}" SelectedItem="{Binding Destination}" PlaceholderText="Send to…" HorizontalAlignment="Stretch" AutomationProperties.Name="Connection destination" />
                <ComboBox ItemsSource="{Binding ChannelChoices}" SelectedItem="{Binding Channel}" HorizontalAlignment="Stretch" AutomationProperties.Name="Connection channel"
                          ToolTip.Tip="Send every event on one channel, or keep each event's own channel" />
                <Button Classes="raised" Content="Connect" Command="{Binding ConnectCommand}" HorizontalAlignment="Stretch" />
              </StackPanel>
            </Expander>

            <Expander x:Name="RacksSection" Classes="section" Header="Racks" IsExpanded="False" DataContext="{Binding Racks}" x:DataType="vm:RacksViewModel">
              <StackPanel Spacing="6">
                <TextBlock Text="A rack is a device chain several tracks can feed, such as one shared instrument. Connect tracks to it in Connections." Classes="muted" TextWrapping="Wrap" IsVisible="{Binding IsEmpty}" />
                <ItemsControl ItemsSource="{Binding Racks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RackRow">
                      <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,4">
                        <StackPanel>
                          <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Rack name" />
                          <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="10" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="tool" Content="Edit" Command="{Binding EditCommand}" VerticalAlignment="Top" ToolTip.Tip="Show the rack's devices and connections" />
                        <Button Grid.Column="2" Classes="tool" Content="✕" Command="{Binding RemoveCommand}" VerticalAlignment="Top" AutomationProperties.Name="Remove rack"
                                ToolTip.Tip="Remove the rack and its connections" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="raised" Content="New rack" Command="{Binding NewRackCommand}" HorizontalAlignment="Stretch" />
              </StackPanel>
            </Expander>

            <Expander x:Name="MixerSection" Classes="section" Header="Mixer" IsExpanded="False" DataContext="{Binding Mixer}" x:DataType="vm:MixerViewModel">
              <StackPanel Spacing="6">
                <TextBlock Text="Mixer channels are audio paths, independent of tracks. They are heard while audio is on (Audio Settings… in the File menu, or the Window menu on macOS). The mixer console (Mixer in the same menu) also shows sends and meters." Classes="muted" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Channels}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MixerChannelRow">
                      <Border BorderBrush="{StaticResource Line.Divider}" BorderThickness="1" CornerRadius="3" Padding="6,4" Margin="0,0,0,4">
                        <StackPanel Spacing="3">
                          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="2">
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Channel name" />
                            <ToggleButton Grid.Column="1" Content="M" IsChecked="{Binding IsMuted}" Padding="6,1" AutomationProperties.Name="Mute channel" />
                            <ToggleButton Grid.Column="2" Content="S" IsChecked="{Binding IsSoloed}" Padding="6,1" AutomationProperties.Name="Solo channel" />
                            <Button Grid.Column="3" Classes="tool" Content="✕" Command="{Binding RemoveCommand}" AutomationProperties.Name="Remove channel" />
                          </Grid>
                          <Grid ColumnDefinitions="30,*,50" RowDefinitions="Auto,Auto" ColumnSpacing="4">
                            <TextBlock Text="Gain" Classes="muted" FontSize="10" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="{Binding MinimumGain}" Maximum="{Binding MaximumGain}" Value="{Binding Gain}" SmallChange="0.5" LargeChange="3" AutomationProperties.Name="Channel gain" />
                            <TextBlock Grid.Column="2" Text="{Binding GainText}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <TextBlock Grid.Row="1" Text="Pan" Classes="muted" FontSize="10" VerticalAlignment="Center" />
                            <Slider Grid.Row="1" Grid.Column="1" Minimum="-1" Maximum="1" Value="{Binding Pan}" SmallChange="0.05" LargeChange="0.25" AutomationProperties.Name="Channel pan" />
                          </Grid>
                          <ComboBox ItemsSource="{Binding Outputs}" SelectedItem="{Binding Output}" HorizontalAlignment="Stretch" AutomationProperties.Name="Channel output"
                                    ToolTip.Tip="Where this channel's audio goes: the master, or another channel used as a bus" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="raised" Content="New mixer channel" Command="{Binding NewChannelCommand}" HorizontalAlignment="Stretch" />
                <Grid ColumnDefinitions="Auto,*,50" ColumnSpacing="6">
                  <TextBlock Text="Master" Classes="label" VerticalAlignment="Center" />
                  <Slider Grid.Column="1" Minimum="-120" Maximum="24" Value="{Binding MasterGain}" SmallChange="0.5" LargeChange="3" AutomationProperties.Name="Master gain" />
                  <TextBlock Grid.Column="2" Text="{Binding MasterGainText}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
              </StackPanel>
            </Expander>

            <Expander Classes="section" Header="Recording" IsExpanded="True">
              <Grid ColumnDefinitions="64,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                <TextBlock Text="Input" Classes="label" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Inputs}" SelectedItem="{Binding SelectedInput}" HorizontalAlignment="Stretch" AutomationProperties.Name="MIDI input" />
                <TextBlock Grid.Row="1" Text="Takes" Classes="label" />
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="TakeModeBox" HorizontalAlignment="Stretch" AutomationProperties.Name="Take mode">
                  <ComboBoxItem Content="Merge (overdub)" />
                  <ComboBoxItem Content="Replace" />
                </ComboBox>
                <TextBlock Grid.Row="2" Text="Count-in" Classes="label" />
                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CountInBox" HorizontalAlignment="Stretch" AutomationProperties.Name="Count-in length">
                  <ComboBoxItem Content="1 bar" />
                  <ComboBoxItem Content="2 bars" />
                </ComboBox>
                <TextBlock Grid.Row="3" Text="Click on" Classes="label" />
                <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding MetronomeOutputs}" SelectedItem="{Binding MetronomeOutput}" HorizontalAlignment="Stretch" AutomationProperties.Name="Metronome output"
                          ToolTip.Tip="Where the metronome clicks (General MIDI wood blocks on channel 10).">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:OutputOption">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <CheckBox Grid.Row="4" Grid.Column="1" Content="Click while playing" IsChecked="{Binding ClickWhilePlaying}" />
                <CheckBox Grid.Row="5" Grid.Column="1" Content="MIDI thru" IsChecked="{Binding IsThruEnabled}"
                          ToolTip.Tip="Play what you hear through the armed or selected track's output." />
              </Grid>
            </Expander>
          </StackPanel>
        </ScrollViewer>
        </Grid>
      </Border>
      <controls:ResizeHandle Edge="Left" Extent="{Binding Workspace.LeftExtent}" Width="6" Margin="0,0,-3,0" HorizontalAlignment="Right"
                             AutomationProperties.Name="Resize inspector" />
      </Panel>

      <!-- Arrangement above, the detail region below -->
      <Grid x:Name="MainArea" Grid.Column="2" RowDefinitions="*,Auto,Auto,330">

        <Grid Grid.Row="0" RowDefinitions="28,30,*" ColumnDefinitions="252,*">
          <!-- Arrangement header -->
          <Border Grid.ColumnSpan="2" Classes="header">
            <Grid ColumnDefinitions="252,*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="2" Margin="8,0" VerticalAlignment="Center">
                <TextBlock Text="Tracks" Classes="title" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button Classes="tool" Command="{Binding AddTrackCommand}" ToolTip.Tip="New track (Ctrl/Cmd+T)" AutomationProperties.Name="New track">
                  <PathIcon Classes="stroke" Data="{StaticResource Icon.Plus}" Width="13" Height="13" />
                </Button>
                <Button Classes="tool" Command="{Binding DuplicateTracksCommand}" ToolTip.Tip="Duplicate the selected tracks (Ctrl/Cmd+D)" AutomationProperties.Name="Duplicate tracks">
                  <PathIcon Classes="stroke" Data="{StaticResource Icon.Duplicate}" Width="13" Height="13" />
                </Button>
                <Button Classes="tool" Command="{Binding DeleteTracksCommand}" ToolTip.Tip="Delete the selected tracks (⌫)" AutomationProperties.Name="Delete tracks">
                  <PathIcon Classes="stroke" Data="{StaticResource Icon.Trash}" Width="13" Height="13" />
                </Button>
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="8,0" VerticalAlignment="Center">
                <Button Classes="tool" Command="{Binding ZoomOutCommand}" ToolTip.Tip="Zoom out (Ctrl/Cmd+−)" AutomationProperties.Name="Zoom out">
                  <PathIcon Classes="stroke" Data="{StaticResource Icon.ZoomOut}" Width="13" Height="13" />
                </Button>
                <Slider x:Name="ZoomSlider" Minimum="6" Maximum="160" Value="{Binding Zoom}" Width="110" VerticalAlignment="Center"
                        ToolTip.Tip="Zoom (⌘/Ctrl + scroll, pinch, or scroll over the ruler)" AutomationProperties.Name="Timeline zoom" />
                <Button Classes="tool" Command="{Binding ZoomInCommand}" ToolTip.Tip="Zoom in (Ctrl/Cmd+=)" AutomationProperties.Name="Zoom in">
                  <PathIcon Classes="stroke" Data="{StaticResource Icon.ZoomIn}" Width="13" Height="13" />
                </Button>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Ruler row -->
          <Border Grid.Row="1" Background="{StaticResource Lane.Ruler}" BorderBrush="{StaticResource Line.Divider}" BorderThickness="0,0,1,1" />
          <controls:RulerView x:Name="Ruler" Grid.Row="1" Grid.Column="1" Project="{Binding Project}" PixelsPerQuarter="{Binding Zoom}"
                              IsRecording="{Binding IsRecording}" AutomationProperties.Name="Bar ruler. Click to move the playhead; drag the top strip to set the cycle." />

          <!-- Track headers, scrolled with the lanes -->
          <ScrollViewer x:Name="TrackHeaderScroller" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden"
                        Background="{StaticResource Lane.Header}">
            <Border BorderBrush="{StaticResource Line.Divider}" BorderThickness="0,0,1,0">
              <ListBox x:Name="TrackList" Classes="tracks" ItemsSource="{Binding Tracks}" SelectedItems="{Binding SelectedTracks}" SelectionMode="Multiple"
                       ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Tracks">
                <ListBox.Styles>
                  <!-- Rows grow to show automation lanes, matching the arrangement. -->
                  <Style Selector="ListBoxItem" x:DataType="vm:TrackViewModel">
                    <Setter Property="Height" Value="{Binding RowHeight}" />
                    <!-- Members of a folded group are hidden under it, as in the arrangement. -->
                    <Setter Property="IsVisible" Value="{Binding IsShown}" />
                    <!-- The divider is drawn under the track's own row instead, where the arrangement draws it. -->
                    <Setter Property="BorderThickness" Value="0" />
                  </Style>
                  <!-- Silenced by a muted group: the name and status are dimmed, like the track's clips. -->
                  <Style Selector="StackPanel.mutedByGroup">
                    <Setter Property="Opacity" Value="0.5" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:TrackViewModel">
                    <Grid RowDefinitions="Auto,*">
                    <!-- Groups: right-click a selected track to group it, put it in a group, or take it out (ADR 0030). -->
                    <Grid.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Group Selected Tracks" Command="{Binding Groups.GroupSelectedCommand}" InputGesture="Ctrl+G" />
                        <MenuItem Header="Add to Group" ItemsSource="{Binding Groups.Available}" IsEnabled="{Binding Groups.Available.Count}">
                          <MenuItem.ItemContainerTheme>
                            <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:TrackViewModel">
                              <Setter Property="Header" Value="{Binding Name}" />
                              <Setter Property="Command" Value="{Binding Groups.AddSelectedToCommand}" />
                              <Setter Property="CommandParameter" Value="{Binding}" />
                            </ControlTheme>
                          </MenuItem.ItemContainerTheme>
                        </MenuItem>
                        <MenuItem Header="Remove from Group" Command="{Binding Groups.RemoveSelectedCommand}" IsEnabled="{Binding Groups.CanRemoveSelected}" />
                      </ContextMenu>
                    </Grid.ContextMenu>
                    <Border Height="{x:Static vm:TrackViewModel.TrackRowHeight}" BorderBrush="{StaticResource Line.Edge}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="3,24,Auto,*,Auto" AutomationProperties.Name="{Binding Name}"
                          Margin="{Binding Indent, Converter={x:Static theme:IndentConverter.Instance}}">
                      <Border Background="{Binding ColorIndex, Converter={x:Static theme:TrackBrushConverter.Instance}}" />
                      <TextBlock Grid.Column="1" Text="{Binding Number}" Classes="muted" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <Border Grid.Column="2" Width="26" Height="26" CornerRadius="3" VerticalAlignment="Center" Margin="0,0,8,0"
                              Background="{Binding ColorIndex, Converter={x:Static theme:TrackTintConverter.Instance}, ConverterParameter=0.28}">
                        <Panel>
                          <PathIcon Classes="stroke" Data="{StaticResource Icon.Piano}" Width="15" Height="15" IsVisible="{Binding !IsGroup}"
                                    Foreground="{Binding ColorIndex, Converter={x:Static theme:TrackBrushConverter.Instance}}" />
                          <PathIcon Classes="stroke" Data="{StaticResource Icon.List}" Width="15" Height="15" IsVisible="{Binding IsGroup}"
                                    Foreground="{Binding ColorIndex, Converter={x:Static theme:TrackBrushConverter.Instance}}" />
                        </Panel>
                      </Border>
                      <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2" Margin="0,0,4,0" Classes.mutedByGroup="{Binding IsMutedByGroup}">
                        <TextBox Classes="inline" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Track name" />
                        <StackPanel Orientation="Horizontal" Spacing="4" ToolTip.Tip="{Binding RouteText}" AutomationProperties.Name="{Binding HealthText}">
                          <PathIcon Data="{StaticResource Icon.Check}" Width="8" Height="8" Foreground="{StaticResource State.Success}" IsVisible="{Binding IsReady}" />
                          <PathIcon Data="{StaticResource Icon.Warning}" Width="8" Height="8" Foreground="{StaticResource State.Warning}" IsVisible="{Binding NeedsAttention}" />
                          <PathIcon Data="{StaticResource Icon.Offline}" Width="8" Height="8" Foreground="{StaticResource Track.Offline}" IsVisible="{Binding IsOffline}" />
                          <TextBlock Text="{Binding StatusLine}" Classes="muted" FontSize="10.5" TextTrimming="CharacterEllipsis" MaxWidth="110" IsVisible="{Binding !IsGroup}" />
                          <TextBlock Text="{Binding MembersText}" Classes="muted" FontSize="10.5" TextTrimming="CharacterEllipsis" MaxWidth="110" IsVisible="{Binding IsGroup}" />
                        </StackPanel>
                      </StackPanel>
                      <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" Margin="0,0,8,0" VerticalAlignment="Center">
                        <ToggleButton Classes="trackButton" IsChecked="{Binding IsFolded}" IsVisible="{Binding IsGroup}"
                                      ToolTip.Tip="Fold or unfold the group's tracks" AutomationProperties.Name="Fold group">
                          <Panel>
                            <PathIcon Classes="stroke" Data="{StaticResource Icon.ChevronDown}" Width="8" Height="8" IsVisible="{Binding !IsFolded}" />
                            <PathIcon Classes="stroke" Data="{StaticResource Icon.ChevronRight}" Width="8" Height="8" IsVisible="{Binding IsFolded}" />
                          </Panel>
                        </ToggleButton>
                        <ToggleButton Classes="trackButton" IsChecked="{Binding IsAutomationExpanded}" IsVisible="{Binding Lanes.Count}"
                                      ToolTip.Tip="Show or hide automation lanes" AutomationProperties.Name="Show automation">
                          <Panel>
                            <PathIcon Classes="stroke" Data="{StaticResource Icon.ChevronRight}" Width="8" Height="8" IsVisible="{Binding !IsAutomationExpanded}" />
                            <PathIcon Classes="stroke" Data="{StaticResource Icon.ChevronDown}" Width="8" Height="8" IsVisible="{Binding IsAutomationExpanded}" />
                          </Panel>
                        </ToggleButton>
                        <Button Classes="trackButton" ToolTip.Tip="Add an automation lane" AutomationProperties.Name="Add automation lane">
                          <PathIcon Classes="stroke" Data="{StaticResource Icon.Plus}" Width="8" Height="8" />
                          <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                              <MenuItem Header="{x:Static vm:AutomationOption.Volume}" Command="{Binding AddLaneCommand}" CommandParameter="{x:Static vm:AutomationOption.Volume}" />
                              <MenuItem Header="{x:Static vm:AutomationOption.Pan}" Command="{Binding AddLaneCommand}" CommandParameter="{x:Static vm:AutomationOption.Pan}" />
                              <MenuItem Header="{x:Static vm:AutomationOption.Expression}" Command="{Binding AddLaneCommand}" CommandParameter="{x:Static vm:AutomationOption.Expression}" />
                              <MenuItem Header="{x:Static vm:AutomationOption.Modulation}" Command="{Binding AddLaneCommand}" CommandParameter="{x:Static vm:AutomationOption.Modulation}" />
                              <MenuItem Header="{x:Static vm:AutomationOption.Sustain}" Command="{Binding AddLaneCommand}" CommandParameter="{x:Static vm:AutomationOption.Sustain}" />
                              <MenuItem Header="{x:Static vm:AutomationOption.Brightness}" Command="{Binding AddLaneCommand}" CommandParameter="{x:Static vm:AutomationOption.Brightness}" />
                              <Separator />
                              <MenuItem Header="{x:Static vm:AutomationOption.PitchBend}" Command="{Binding AddLaneCommand}" CommandParameter="{x:Static vm:AutomationOption.PitchBend}" />
                              <MenuItem Header="{x:Static vm:AutomationOption.ChannelPressure}" Command="{Binding AddLaneCommand}" CommandParameter="{x:Static vm:AutomationOption.ChannelPressure}" />
                              <Separator IsVisible="{Binding HasHardwareParameters}" />
                              <MenuItem Header="Instrument parameters" ItemsSource="{Binding HardwareParameters}" IsVisible="{Binding HasHardwareParameters}">
                                <MenuItem.ItemContainerTheme>
                                  <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:HardwareParameterOption">
                                    <Setter Property="Header" Value="{Binding Name}" />
                                    <Setter Property="Command" Value="{Binding Add}" />
                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                  </ControlTheme>
                                </MenuItem.ItemContainerTheme>
                              </MenuItem>
                            </MenuFlyout>
                          </Button.Flyout>
                        </Button>
                        <ToggleButton Classes="trackButton mute" Content="M" IsChecked="{Binding IsMuted}" ToolTip.Tip="Mute (M)" AutomationProperties.Name="Mute" />
                        <ToggleButton Classes="trackButton solo" Content="S" IsChecked="{Binding IsSoloed}" ToolTip.Tip="Solo (S)" AutomationProperties.Name="Solo" />
                        <ToggleButton Classes="trackButton arm" IsChecked="{Binding IsArmed}" IsVisible="{Binding !IsGroup}" ToolTip.Tip="Arm for recording" AutomationProperties.Name="Record arm">
                          <PathIcon Data="{StaticResource Icon.Record}" Width="8" Height="8" />
                        </ToggleButton>
                      </StackPanel>
                    </Grid>
                    </Border>
                    <!-- Automation lane headers, one per lane row in the arrangement -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Lanes}" IsVisible="{Binding IsAutomationExpanded}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AutomationLaneViewModel">
                          <Grid Height="{x:Static vm:TrackViewModel.AutomationLaneHeight}" ColumnDefinitions="27,*,Auto" Background="{StaticResource Lane.Automation}" AutomationProperties.Name="{Binding Name}">
                            <Border Grid.Column="1" BorderBrush="{StaticResource Line.Edge}" BorderThickness="0,1,0,0" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="muted" FontSize="10.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="2" Classes="trackButton" Margin="0,0,8,0" VerticalAlignment="Center"
                                    Command="{Binding Track.RemoveLaneCommand}" CommandParameter="{Binding}"
                                    ToolTip.Tip="Delete this automation lane" AutomationProperties.Name="Delete automation lane">
                              <PathIcon Classes="stroke" Data="{StaticResource Icon.Trash}" Width="9" Height="9" />
                            </Button>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
          </ScrollViewer>

          <!-- Lanes -->
          <ScrollViewer x:Name="TimelineScroller" Grid.Row="2" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                        Background="{StaticResource Lane.Background}">
            <Panel>
              <controls:TimelineView x:Name="Timeline" Project="{Binding Project}" PixelsPerQuarter="{Binding Zoom}" ExpandedTracks="{Binding ExpandedTracks}" HiddenTracks="{Binding Groups.HiddenTracks}"
                                     LaneHeight="{x:Static vm:TrackViewModel.TrackRowHeight}" AutomationLaneHeight="{x:Static vm:TrackViewModel.AutomationLaneHeight}"
                                     RecordingLane="{Binding RecordingLane}" RecordingPreview="{Binding RecordingPreview}"
                                     AutomationProperties.Name="Arrangement. Click a clip to select it and drag to move it; double-click to edit its notes. Click in an automation lane to add a point." />
              <controls:PlayheadOverlay x:Name="Playhead" IsRecording="{Binding IsRecording}" IsVisible="{Binding Tracks.Count}" />
              <!-- Renames a clip in place, over its name strip (double-click the strip, or Return). -->
              <Canvas>
                <TextBox x:Name="ClipNameBox" Classes="clipName" IsVisible="False" AutomationProperties.Name="Clip name" />
              </Canvas>
            </Panel>
          </ScrollViewer>

          <!-- Empty state -->
          <StackPanel Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                      IsVisible="{Binding !Tracks.Count}">
            <PathIcon Classes="stroke" Data="{StaticResource Icon.PianoRoll}" Width="34" Height="34" Foreground="{StaticResource Line.BorderStrong}" />
            <TextBlock Text="Start with a MIDI file or a new track" Classes="title" HorizontalAlignment="Center" />
            <TextBlock Text="Drop a .mid or .bluestone file anywhere on the window." Classes="secondary" HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <Button Classes="primary" Content="Import MIDI…" Command="{Binding ImportMidiCommand}" />
              <Button Classes="raised" Content="New Track" Command="{Binding AddTrackCommand}" />
            </StackPanel>
          </StackPanel>
        </Grid>

        <controls:ResizeHandle x:Name="DetailHandle" Grid.Row="1" Edge="Below" Extent="{Binding Workspace.DetailExtent}" Height="6" Margin="0,-3,0,-3" ZIndex="1"
                               IsVisible="{Binding IsEditorVisible}" AutomationProperties.Name="Resize the detail region" />

        <!-- Lower pane header: tabs and the active editor's tools -->
        <Border x:Name="EditorHeader" Grid.Row="2" Classes="header" BorderThickness="0,1,0,1">
          <Grid ColumnDefinitions="Auto,*,Auto" Height="28">
            <StackPanel Orientation="Horizontal">
              <!-- Docked Device Views, each its own tab; "+" opens another that follows the selection. -->
              <ItemsControl x:Name="DeviceTabs" ItemsSource="{Binding Workspace.DetailTabs}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:WorkspaceView">
                    <RadioButton Classes="tab" GroupName="LowerPane" IsChecked="{Binding IsCurrentTab, Mode=OneWay}" Command="{Binding ShowCommand}"
                                 AutomationProperties.Name="{Binding RailLabel}" ToolTip.Tip="{Binding Title}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Classes="stroke" Data="{StaticResource Icon.Devices}" Width="13" Height="13" />
                        <TextBlock Text="{Binding Title}" MaxWidth="140" TextTrimming="CharacterEllipsis" />
                        <PathIcon Classes="stroke" Data="{StaticResource Icon.Lock}" Width="10" Height="10" IsVisible="{Binding DeviceView.IsLocked, FallbackValue=False}" Opacity="0.7" />
                      </StackPanel>
                      <RadioButton.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Detach to Window" Command="{Binding DetachCommand}" />
                          <MenuItem Header="Collapse to Rail" Command="{Binding CollapseCommand}" />
                          <MenuItem Header="Close" Command="{Binding CloseCommand}" />
                        </ContextMenu>
                      </RadioButton.ContextMenu>
                    </RadioButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Classes="tool small" Command="{Binding Workspace.AddDeviceViewCommand}" VerticalAlignment="Center" Margin="2,0"
                      ToolTip.Tip="New Device View, following the selected track" AutomationProperties.Name="New Device View">
                <PathIcon Classes="stroke" Data="{StaticResource Icon.Plus}" />
              </Button>
              <Border Classes="separator" Height="14" />
              <RadioButton Classes="tab" GroupName="LowerPane" IsChecked="{Binding LowerPane, Mode=OneWay, Converter={x:Static theme:EnumEqualsConverter.Instance}, ConverterParameter=PianoRoll}"
                           Command="{Binding ShowPaneCommand}" CommandParameter="{x:Static vm:LowerPane.PianoRoll}" AutomationProperties.Name="Piano roll">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Classes="stroke" Data="{StaticResource Icon.PianoRoll}" Width="13" Height="13" />
                  <TextBlock Text="Piano Roll" />
                </StackPanel>
              </RadioButton>
              <RadioButton Classes="tab" GroupName="LowerPane" IsChecked="{Binding LowerPane, Mode=OneWay, Converter={x:Static theme:EnumEqualsConverter.Instance}, ConverterParameter=EventList}"
                           Command="{Binding ShowPaneCommand}" CommandParameter="{x:Static vm:LowerPane.EventList}" AutomationProperties.Name="Event list">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Classes="stroke" Data="{StaticResource Icon.List}" Width="13" Height="13" />
                  <TextBlock Text="Event List" />
                </StackPanel>
              </RadioButton>
              <RadioButton Classes="tab" GroupName="LowerPane" IsChecked="{Binding LowerPane, Mode=OneWay, Converter={x:Static theme:EnumEqualsConverter.Instance}, ConverterParameter=Monitor}"
                           Command="{Binding ShowPaneCommand}" CommandParameter="{x:Static vm:LowerPane.Monitor}" AutomationProperties.Name="MIDI monitor">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Classes="stroke" Data="{StaticResource Icon.Monitor}" Width="13" Height="13" />
                  <TextBlock Text="MIDI Monitor" />
                </StackPanel>
              </RadioButton>
              <RadioButton Classes="tab" GroupName="LowerPane" IsChecked="{Binding LowerPane, Mode=OneWay, Converter={x:Static theme:EnumEqualsConverter.Instance}, ConverterParameter=Messages}"
                           Command="{Binding ShowPaneCommand}" CommandParameter="{x:Static vm:LowerPane.Messages}" AutomationProperties.Name="Messages">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Classes="stroke" Data="{StaticResource Icon.Messages}" Width="13" Height="13" />
                  <TextBlock Text="Messages" />
                </StackPanel>
              </RadioButton>
            </StackPanel>

            <!-- Piano roll tools -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" Margin="8,0" VerticalAlignment="Center" DataContext="{Binding Editor}" x:DataType="vm:EditorViewModel"
                        IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).LowerPane, Converter={x:Static theme:EnumEqualsConverter.Instance}, ConverterParameter=PianoRoll}">
              <ToggleButton Classes="tool" IsChecked="{Binding IsArrow}" ToolTip.Tip="Arrow: select, move, and resize (1)" AutomationProperties.Name="Arrow tool">
                <PathIcon Data="{StaticResource Icon.Arrow}" Width="13" Height="13" />
              </ToggleButton>
              <ToggleButton Classes="tool" IsChecked="{Binding IsPencil}" ToolTip.Tip="Pencil: draw notes and controller lines (2)" AutomationProperties.Name="Pencil tool">
                <PathIcon Classes="stroke" Data="{StaticResource Icon.Pencil}" Width="14" Height="14" />
              </ToggleButton>
              <ToggleButton Classes="tool" IsChecked="{Binding IsEraser}" ToolTip.Tip="Eraser: delete notes and controller points (3)" AutomationProperties.Name="Eraser tool">
                <PathIcon Classes="stroke" Data="{StaticResource Icon.Eraser}" Width="14" Height="14" />
              </ToggleButton>
              <Border Classes="separator" Height="16" />
              <ToggleButton Classes="tool" IsChecked="{Binding IsSnapEnabled}" ToolTip.Tip="Snap to grid (hold ⌘/Ctrl while dragging to ignore it)" AutomationProperties.Name="Snap">
                <PathIcon Classes="stroke" Data="{StaticResource Icon.Magnet}" Width="14" Height="14" />
              </ToggleButton>
              <ComboBox ItemsSource="{x:Static vm:GridOption.All}" SelectedItem="{Binding Snap}" Width="74" AutomationProperties.Name="Snap grid" ToolTip.Tip="Grid" />
              <Border Classes="separator" Height="16" />
              <Button Classes="tool" Command="{Binding QuantizeCommand}" Width="30" ToolTip.Tip="Quantize the selection, or the whole track (Q)" AutomationProperties.Name="Quantize">
                <TextBlock Text="Q" FontWeight="Bold" FontSize="12" />
              </Button>
              <ComboBox ItemsSource="{x:Static vm:GridOption.All}" SelectedItem="{Binding QuantizeGrid}" Width="74" AutomationProperties.Name="Quantize grid" ToolTip.Tip="Quantize to" />
              <NumericUpDown Classes="compact" Value="{Binding QuantizeStrength}" Minimum="0" Maximum="100" Increment="10" Width="50" FormatString="0'%'" ShowButtonSpinner="False"
                             ToolTip.Tip="Quantize strength (scroll or type)" AutomationProperties.Name="Quantize strength" />
              <TextBlock Text="Swing" Classes="label" Margin="4,0,0,0" />
              <NumericUpDown Classes="compact" Value="{Binding Swing}" Minimum="50" Maximum="75" Increment="1" Width="40" FormatString="0" ShowButtonSpinner="False"
                             ToolTip.Tip="Swing: 50 is straight, 66 is a triplet feel" AutomationProperties.Name="Swing" />
              <Border Classes="separator" Height="16" />
              <ComboBox ItemsSource="{x:Static vm:ControllerLane.Standard}" SelectedItem="{Binding Lane}" Width="150" AutomationProperties.Name="Controller lane" ToolTip.Tip="What the lower lane shows and edits" />
              <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsLaneOverridden}"
                          ToolTip.Tip="A track automation lane controls this, so these events do not play"
                          AutomationProperties.Name="Overridden by track automation">
                <PathIcon Data="{StaticResource Icon.Warning}" Width="9" Height="9" Foreground="{StaticResource State.Warning}" />
                <TextBlock Text="Overridden by automation" Classes="muted" FontSize="10.5" VerticalAlignment="Center" />
              </StackPanel>
              <ToggleButton Classes="tool" IsChecked="{Binding FollowPlayhead}" ToolTip.Tip="Follow the playhead" AutomationProperties.Name="Follow playhead">
                <PathIcon Classes="stroke" Data="{StaticResource Icon.Follow}" Width="14" Height="14" />
              </ToggleButton>
            </StackPanel>

            <!-- Event list tools -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="8,0" VerticalAlignment="Center" DataContext="{Binding EventList}" x:DataType="vm:EventListViewModel"
                        IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).LowerPane, Converter={x:Static theme:EnumEqualsConverter.Instance}, ConverterParameter=EventList}">
              <TextBlock Text="{Binding CountText}" Classes="muted" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{x:Static vm:EventFilter.All}" SelectedItem="{Binding Filter}" Width="160" AutomationProperties.Name="Show events" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="8,0" VerticalAlignment="Center"
                        IsVisible="{Binding LowerPane, Converter={x:Static theme:EnumEqualsConverter.Instance}, ConverterParameter=Messages}">
              <Button Classes="ghost" Content="Clear" Command="{Binding ClearMessagesCommand}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="8,0" VerticalAlignment="Center"
                        IsVisible="{Binding LowerPane, Converter={x:Static theme:EnumEqualsConverter.Instance}, ConverterParameter=Monitor}">
              <TextBlock Text="{Binding MonitorName}" Classes="muted" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Lower pane content -->
        <Panel Grid.Row="3" x:Name="EditorPane" IsVisible="{Binding IsEditorVisible}" Background="{StaticResource Surface.Panel}">

          <!-- The docked Device View whose tab is selected -->
          <Panel x:Name="DevicePane" IsVisible="{Binding LowerPane, Converter={x:Static theme:EnumEqualsConverter.Instance}, ConverterParameter=Devices}">
            <ContentControl x:Name="DockedDeviceView" Content="{Binding Workspace.DetailDeviceView.DeviceView, FallbackValue={x:Null}}" />
            <StackPanel Classes="emptyState" IsVisible="{Binding Workspace.DetailDeviceView, Converter={x:Static ObjectConverters.IsNull}}">
              <PathIcon Classes="stroke" Data="{StaticResource Icon.Devices}" Width="26" Height="26" Foreground="{StaticResource Line.BorderStrong}" />
              <TextBlock Classes="emptyTitle" Text="No Device View is docked here" />
              <Button Classes="raised compact" Content="New Device View" Command="{Binding Workspace.AddDeviceViewCommand}" HorizontalAlignment="Center" />
            </StackPanel>
          </Panel>

          <!-- Piano roll -->
          <Grid RowDefinitions="Auto,*" IsVisible="{Binding LowerPane, Converter={x:Static theme:EnumEqualsConverter.Instance}, ConverterParameter=PianoRoll}">
            <Border Background="{StaticResource TrackRow}" BorderBrush="{StaticResource Line.Divider}" BorderThickness="0,0,0,1" Padding="8,3" DataContext="{Binding Editor}" x:DataType="vm:EditorViewModel">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding Track.Name, FallbackValue='No track'}" Classes="title" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="Position" Classes="label" />
                <TextBox Classes="field commit" Text="{Binding InfoPosition, UpdateSourceTrigger=LostFocus}" Width="80" IsEnabled="{Binding HasSelection}" AutomationProperties.Name="Selection position" />
                <TextBlock Text="Length" Classes="label" Margin="6,0,0,0" />
                <TextBox Classes="field commit" Text="{Binding InfoLength, UpdateSourceTrigger=LostFocus}" Width="72" IsEnabled="{Binding HasSelection}" AutomationProperties.Name="Note length" />
                <TextBlock Text="Pitch" Classes="label" Margin="6,0,0,0" />
                <TextBox Classes="field commit" Text="{Binding InfoPitch, UpdateSourceTrigger=LostFocus}" Width="48" IsEnabled="{Binding HasSelection}" AutomationProperties.Name="Pitch" />
                <TextBlock Text="Velocity" Classes="label" Margin="6,0,0,0" />
                <TextBox Classes="field commit" Text="{Binding InfoVelocity, UpdateSourceTrigger=LostFocus}" Width="40" IsEnabled="{Binding HasSelection}" AutomationProperties.Name="Velocity" />
                <TextBlock Text="Channel" Classes="label" Margin="6,0,0,0" />
                <TextBox Classes="field commit" Text="{Binding InfoChannel, UpdateSourceTrigger=LostFocus}" Width="34" IsEnabled="{Binding HasSelection}" AutomationProperties.Name="Channel" />
                <TextBlock Text="{Binding SelectionSummary}" Classes="muted" VerticalAlignment="Center" Margin="10,0,0,0" />
              </StackPanel>
            </Border>
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
              <controls:PianoRollView x:Name="PianoRoll" Project="{Binding Project}" IsRecording="{Binding IsRecording}"
                                      AutomationProperties.Name="Piano roll. Arrow keys move and transpose the selected notes." />
              <ScrollBar x:Name="PianoRollVertical" Grid.Column="1" Orientation="Vertical" AllowAutoHide="False" />
              <ScrollBar x:Name="PianoRollHorizontal" Grid.Row="1" Orientation="Horizontal" AllowAutoHide="False" />
            </Grid>
          </Grid>

          <!-- Event list -->
          <Grid RowDefinitions="Auto,*" IsVisible="{Binding LowerPane, Converter={x:Static theme:EnumEqualsConverter.Instance}, ConverterParameter=EventList}">
            <Border Background="{StaticResource TrackRow}" BorderBrush="{StaticResource Line.Divider}" BorderThickness="0,0,0,1" Height="22">
              <Grid ColumnDefinitions="100,100,44,80,70,100,*" Margin="0,0,0,0">
                <TextBlock Text="POSITION" Classes="overline" VerticalAlignment="Center" Margin="10,0" />
                <TextBlock Grid.Column="1" Text="STATUS" Classes="overline" VerticalAlignment="Center" Margin="6,0" />
                <TextBlock Grid.Column="2" Text="CH" Classes="overline" VerticalAlignment="Center" Margin="6,0" />
                <TextBlock Grid.Column="3" Text="NUM" Classes="overline" VerticalAlignment="Center" Margin="6,0" />
                <TextBlock Grid.Column="4" Text="VAL" Classes="overline" VerticalAlignment="Center" Margin="6,0" />
                <TextBlock Grid.Column="5" Text="LENGTH" Classes="overline" VerticalAlignment="Center" Margin="6,0" />
              </Grid>
            </Border>
            <ListBox x:Name="EventListBox" Grid.Row="1" Classes="grid" ItemsSource="{Binding EventList.Rows}" SelectedItems="{Binding EventList.SelectedRows}" SelectionMode="Multiple"
                     Background="Transparent" AutomationProperties.Name="Events">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:EventRow">
                  <Grid ColumnDefinitions="100,100,44,80,70,100,*">
                    <TextBox Classes="cell commit" Text="{Binding Position, UpdateSourceTrigger=LostFocus}" Margin="4,0,0,0" AutomationProperties.Name="Position" />
                    <TextBlock Grid.Column="1" Text="{Binding Kind}" VerticalAlignment="Center" Margin="6,0" FontSize="11.5" Classes="secondary" />
                    <TextBox Grid.Column="2" Classes="cell commit" Text="{Binding Channel, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding !CanEditData}" AutomationProperties.Name="Channel" />
                    <TextBox Grid.Column="3" Classes="cell commit" Text="{Binding Data1, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding !CanEditData}" AutomationProperties.Name="Note or number" />
                    <TextBox Grid.Column="4" Classes="cell commit" Text="{Binding Data2, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding !CanEditData}" AutomationProperties.Name="Value" />
                    <TextBox Grid.Column="5" Classes="cell commit" Text="{Binding Length, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding !CanEditLength}" AutomationProperties.Name="Length" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>

          <!-- MIDI monitor -->
          <ListBox x:Name="MonitorList" Classes="dense" ItemsSource="{Binding MonitorEntries}" ClipToBounds="True" AutomationProperties.Name="MIDI monitor"
                   IsVisible="{Binding LowerPane, Converter={x:Static theme:EnumEqualsConverter.Instance}, ConverterParameter=Monitor}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:MonitorEntry">
                <TextBlock Text="{Binding Text}" FontFamily="{StaticResource Font.Mono}" FontSize="11.5" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Messages -->
          <ListBox Classes="dense" ItemsSource="{Binding Messages}" ClipToBounds="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Messages"
                   IsVisible="{Binding LowerPane, Converter={x:Static theme:EnumEqualsConverter.Instance}, ConverterParameter=Messages}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:MessageItem">
                <Grid ColumnDefinitions="64,80,*">
                  <TextBlock Text="{Binding SeverityText}" Classes="muted" />
                  <TextBlock Grid.Column="1" Text="{Binding Source}" Classes="muted" />
                  <TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Panel>
      </Grid>

      <!-- Browser -->
      <Panel x:Name="BrowserDock" Grid.Column="3" Width="{Binding Workspace.RightExtent}" IsVisible="{Binding Workspace.Browser.IsDocked}" ZIndex="1">
        <Border Classes="pane" BorderBrush="{StaticResource Line.Divider}" BorderThickness="1,0,0,0">
          <Grid RowDefinitions="Auto,*">
            <Border Classes="dockHeader">
              <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Classes="dockTitle" Text="BROWSER" />
                <Button Grid.Column="1" Classes="tool small" Command="{Binding Workspace.Browser.DetachCommand}" ToolTip.Tip="Detach to its own window" AutomationProperties.Name="Detach Browser">
                  <PathIcon Classes="stroke" Data="{StaticResource Icon.Detach}" />
                </Button>
                <Button Grid.Column="2" Classes="tool small" Command="{Binding Workspace.Browser.CollapseCommand}" ToolTip.Tip="Collapse to the rail (B)" AutomationProperties.Name="Collapse Browser">
                  <PathIcon Classes="stroke" Data="{StaticResource Icon.ChevronRight}" />
                </Button>
              </Grid>
            </Border>
            <views:BrowserView x:Name="DockedBrowser" Grid.Row="1" DataContext="{Binding Browser}" />
          </Grid>
        </Border>
        <controls:ResizeHandle Edge="Right" Extent="{Binding Workspace.RightExtent}" Width="6" Margin="-3,0,0,0" HorizontalAlignment="Left"
                               AutomationProperties.Name="Resize Browser" />
      </Panel>

      <Border x:Name="RightRail" Grid.Column="4" Classes="rail right" IsVisible="{Binding Workspace.RightRail.Count}">
        <ItemsControl ItemsSource="{Binding Workspace.RightRail}" ItemTemplate="{StaticResource RailItem}" />
      </Border>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="2" Background="{StaticResource Surface.Chrome}" BorderBrush="{StaticResource Line.Divider}" BorderThickness="0,1,0,0" Height="22">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="10,0">
        <TextBlock Text="{Binding OutputsText}" Classes="muted" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Classes="muted" VerticalAlignment="Center" Margin="16,0,0,0"
                   Text="{Binding SelectedInput.Name, StringFormat='MIDI in: {0}', FallbackValue=''}" />
        <TextBlock x:Name="LastMessage" Grid.Column="2" Classes="muted" VerticalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="3" Text="{Binding TimingText}" Classes="muted" VerticalAlignment="Center" AutomationProperties.Name="Playback timing" />
      </Grid>
    </Border>
  </Grid>

  <!-- Shown while a supported file is dragged over the window. -->
  <Border x:Name="DropOverlay" IsVisible="False" IsHitTestVisible="False" Margin="8"
          Background="{StaticResource Overlay.Scrim}" BorderBrush="{StaticResource Accent}" BorderThickness="2" CornerRadius="4">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
      <PathIcon Data="{StaticResource Icon.Logo}" Width="32" Height="32" Foreground="{StaticResource Accent}" />
      <TextBlock x:Name="DropText" Classes="title" HorizontalAlignment="Center" />
      <TextBlock x:Name="DropDetail" Classes="secondary" HorizontalAlignment="Center" />
    </StackPanel>
  </Border>
  </Panel>
</Window>
