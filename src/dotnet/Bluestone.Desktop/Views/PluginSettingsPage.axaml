<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Bluestone.Presentation"
             x:Class="Bluestone.Desktop.Views.PluginSettingsPage"
             x:DataType="vm:PluginsViewModel"
             AutomationProperties.Name="Plugin settings">
  <!-- What the plugin scan found and how plugins are hosted: available plugins, modules that could not be read, and quarantined modules. -->
  <StackPanel Classes="settingsGroups">
    <StackPanel Classes="settingsGroup">
      <TextBlock Classes="overline" Text="SCANNING" />
      <TextBlock Text="Each module is read in its own scanner process. A module that crashes or hangs its scanner is quarantined and skipped until you retry it."
                 Classes="settingHint" TextWrapping="Wrap" />
      <TextBlock Text="Folders" Classes="label" />
      <ItemsControl ItemsSource="{Binding Folders}" AutomationProperties.Name="Plugin folders">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <SelectableTextBlock Text="{Binding}" Classes="secondary" TextWrapping="Wrap" FontSize="11" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <StackPanel Spacing="4" VerticalAlignment="Center">
          <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="1" IsVisible="{Binding IsBusy}" AutomationProperties.Name="Scan progress" />
          <TextBlock Text="{Binding ProgressText}" Classes="muted" TextTrimming="CharacterEllipsis" IsVisible="{Binding IsBusy}" />
          <TextBlock x:Name="StatusLine" Text="{Binding StatusText}" Classes="secondary" TextWrapping="Wrap" AutomationProperties.Name="Scan result" />
        </StackPanel>
        <Button Grid.Column="1" Classes="raised" Content="Rescan all" Command="{Binding RescanAllCommand}" VerticalAlignment="Top"
                ToolTip.Tip="Read every module in the plugin folders again. Quarantined modules stay skipped." />
      </Grid>
    </StackPanel>

    <StackPanel x:Name="HostingSection" Classes="settingsGroup" IsVisible="{Binding HasHosting}" IsEnabled="{Binding !IsBusy}">
      <TextBlock Text="HOSTING" Classes="overline" />
      <TextBlock Text="Plugins run in worker processes, never inside Bluestone. A crash takes down every plugin in the same process and nothing else. This is crash isolation, not a security sandbox."
                 Classes="settingHint" TextWrapping="Wrap" />
      <Grid Classes="settingRow" ColumnDefinitions="180,*" RowDefinitions="Auto,Auto">
        <TextBlock Text="Share processes" Classes="label" />
        <ComboBox x:Name="GlobalHosting" Grid.Column="1" ItemsSource="{Binding HostingModes}" SelectedItem="{Binding GlobalHosting}" HorizontalAlignment="Stretch"
                  AutomationProperties.Name="Global hosting mode" ToolTip.Tip="How plugins share worker processes, unless set for a plugin below" />
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GlobalHostingText}" Classes="muted" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0" />
      </Grid>
      <CheckBox x:Name="AutoRestart" Content="Restart crashed plugins automatically (up to 3 times in 5 minutes)" IsChecked="{Binding AutoRestart}"
                AutomationProperties.Name="Restart crashed plugins automatically" />
    </StackPanel>

    <StackPanel Classes="settingsGroup" IsVisible="{Binding HasQuarantined}">
      <TextBlock Text="QUARANTINED" Classes="overline" />
      <ItemsControl x:Name="QuarantinedList" ItemsSource="{Binding Quarantined}" AutomationProperties.Name="Quarantined modules">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ModuleProblemRow">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
              <PathIcon Data="{StaticResource Icon.Warning}" Width="11" Height="11" Foreground="{StaticResource State.Warning}" VerticalAlignment="Top" Margin="0,3,6,0" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Module}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ModulePath}" />
                <TextBlock Text="{Binding Problem}" Classes="muted" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Problem}" />
              </StackPanel>
              <Button Grid.Column="2" Classes="raised" Content="Retry" VerticalAlignment="Top" Margin="8,0,0,0"
                      Command="{Binding $parent[ItemsControl].((vm:PluginsViewModel)DataContext).RetryCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}"
                      ToolTip.Tip="Read this module again in a new scanner process" AutomationProperties.Name="Retry module" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <StackPanel Classes="settingsGroup" IsVisible="{Binding HasFailures}">
      <TextBlock Text="COULD NOT BE READ" Classes="overline" />
      <ItemsControl ItemsSource="{Binding Failures}" AutomationProperties.Name="Modules that could not be read">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ModuleProblemRow">
            <StackPanel Margin="0,0,0,6">
              <TextBlock Text="{Binding Module}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ModulePath}" />
              <TextBlock Text="{Binding Problem}" Classes="muted" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Problem}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <StackPanel Classes="settingsGroup">
      <TextBlock Text="AVAILABLE" Classes="overline" />
      <TextBlock Text="No plugins found." Classes="muted" IsVisible="{Binding !Plugins.Count}" />
      <ItemsControl x:Name="PluginList" ItemsSource="{Binding Plugins}" AutomationProperties.Name="Available plugins">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PluginRow">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,0,0,6">
              <StackPanel>
                <TextBlock Text="{Binding Name}" />
                <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="10" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="2" Margin="8,0,0,0">
                <TextBlock Text="{Binding Module}" Classes="muted" FontSize="10" HorizontalAlignment="Right" />
                <ComboBox ItemsSource="{Binding $parent[ItemsControl].((vm:PluginsViewModel)DataContext).PluginHostingChoices, FallbackValue={x:Null}}"
                          SelectedItem="{Binding Hosting}" MinWidth="170" FontSize="11"
                          IsEnabled="{Binding !$parent[ItemsControl].((vm:PluginsViewModel)DataContext).IsBusy, FallbackValue=False}"
                          IsVisible="{Binding $parent[ItemsControl].((vm:PluginsViewModel)DataContext).HasHosting, FallbackValue=False}"
                          AutomationProperties.Name="Plugin hosting mode" ToolTip.Tip="How this plugin shares a worker process" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasCrashed}" Margin="0,2,0,0">
                <PathIcon Data="{StaticResource Icon.Warning}" Width="11" Height="11" Foreground="{StaticResource State.Warning}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CrashText}" Classes="muted" FontSize="10" TextWrapping="Wrap" MaxWidth="380" VerticalAlignment="Center" AutomationProperties.Name="Crashes" />
                <Button Classes="raised" Content="Host individually" IsVisible="{Binding CanHostIndividually}" Command="{Binding HostIndividuallyCommand}" FontSize="11"
                        IsEnabled="{Binding !$parent[ItemsControl].((vm:PluginsViewModel)DataContext).IsBusy, FallbackValue=False}"
                        ToolTip.Tip="Give every copy of this plugin a process of its own, so its crashes take nothing else down" AutomationProperties.Name="Host individually" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </StackPanel>
</UserControl>
