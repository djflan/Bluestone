<Project Sdk="Microsoft.NET.Sdk">
  <!-- Desktop composition root and Avalonia views. All behavior lives in Bluestone.Presentation and below. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Bluestone.Desktop</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationTitle>Bluestone</ApplicationTitle>
    <!-- For the source-generated P/Invoke that sets the macOS Dock icon (Services/DockIcon.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Bluestone.Tests.Ui" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Bluestone.Platform.Alsa/Bluestone.Platform.Alsa.csproj" />
    <ProjectReference Include="../Bluestone.Platform.CoreMidi/Bluestone.Platform.CoreMidi.csproj" />
    <ProjectReference Include="../Bluestone.Platform.Windows/Bluestone.Platform.Windows.csproj" />
    <ProjectReference Include="../Bluestone.Presentation/Bluestone.Presentation.csproj" />
    <!-- Plugins run in this worker, a separate process copied beside the app; it is never loaded into the app. -->
    <ProjectReference Include="../Bluestone.PluginWorker/Bluestone.PluginWorker.csproj" ReferenceOutputAssembly="false" OutputItemType="Content" CopyToOutputDirectory="PreserveNewest" />
    <!-- The engine process (ADR 0044), also copied beside the app and never loaded into it. -->
    <ProjectReference Include="../Bluestone.Engine/Bluestone.Engine.csproj" ReferenceOutputAssembly="false" OutputItemType="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Images built into the app (avares://Bluestone.Desktop/Assets/...), such as the splash artwork. -->
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shipped device profiles are data, copied beside the executable. -->
    <None Include="Profiles/*.bluestone-profile.json" Link="profiles/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
