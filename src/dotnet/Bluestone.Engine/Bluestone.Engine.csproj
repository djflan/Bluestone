<Project Sdk="Microsoft.NET.Sdk">
  <!-- The engine process (ADR 0044), published with NativeAOT. It references the real-time assemblies it will own and
       roots them whole, so the trim and AOT analysis covers all of their code, not only what it calls today. Bluestone
       starts it with a pipe and a token; given "spike" it runs the ahead-of-time smoke test (migration step 2). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Bluestone.Engine</RootNamespace>
    <PublishAot>true</PublishAot>
    <!-- A JIT build of the engine (development) compiles each method once, fully optimized: no tier-up during playback
         (ADR 0043). The shipped engine is NativeAOT and has no JIT at all. -->
    <TieredCompilation>false</TieredCompilation>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Bluestone.Audio/Bluestone.Audio.csproj" />
    <ProjectReference Include="../Bluestone.Engine.Protocol/Bluestone.Engine.Protocol.csproj" />
    <ProjectReference Include="../Bluestone.Midi/Bluestone.Midi.csproj" />
    <ProjectReference Include="../Bluestone.Playback/Bluestone.Playback.csproj" />
    <ProjectReference Include="../Bluestone.Plugins/Bluestone.Plugins.csproj" />
    <ProjectReference Include="../Bluestone.Plugins.Protocol/Bluestone.Plugins.Protocol.csproj" />
    <ProjectReference Include="../Bluestone.Signal/Bluestone.Signal.csproj" />
    <ProjectReference Include="../Bluestone.Platform.Alsa/Bluestone.Platform.Alsa.csproj" />
    <ProjectReference Include="../Bluestone.Platform.CoreMidi/Bluestone.Platform.CoreMidi.csproj" />
    <ProjectReference Include="../Bluestone.Platform.Windows/Bluestone.Platform.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <TrimmerRootAssembly Include="Bluestone.Audio" />
    <TrimmerRootAssembly Include="Bluestone.Domain" />
    <TrimmerRootAssembly Include="Bluestone.Engine.Protocol" />
    <TrimmerRootAssembly Include="Bluestone.Midi" />
    <TrimmerRootAssembly Include="Bluestone.Playback" />
    <TrimmerRootAssembly Include="Bluestone.Plugins" />
    <TrimmerRootAssembly Include="Bluestone.Plugins.Protocol" />
    <TrimmerRootAssembly Include="Bluestone.Signal" />
    <TrimmerRootAssembly Include="Bluestone.Platform.Alsa" />
    <TrimmerRootAssembly Include="Bluestone.Platform.CoreMidi" />
    <TrimmerRootAssembly Include="Bluestone.Platform.Windows" />
  </ItemGroup>
</Project>
