<Project Sdk="Microsoft.NET.Sdk">
  <!-- Performance measurements. Run in Release; see docs/adr/0012-performance-baseline.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Bluestone.Benchmarks</RootNamespace>
    <!-- The Core MIDI loopback sink reads packet lists with pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Benchmark methods must be instance members even when they touch no state (CA1822),
         and BenchmarkDotNet owns disposal of benchmark instances (CA1001). -->
    <NoWarn>$(NoWarn);CA1822;CA1001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Bluestone.Application/Bluestone.Application.csproj" />
    <ProjectReference Include="../Bluestone.Audio/Bluestone.Audio.csproj" />
    <ProjectReference Include="../Bluestone.Infrastructure/Bluestone.Infrastructure.csproj" />
    <!-- Alsa only for the engine's JIT build copied beside the probes, which loads all three platform adapters. -->
    <ProjectReference Include="../Bluestone.Platform.Alsa/Bluestone.Platform.Alsa.csproj" />
    <ProjectReference Include="../Bluestone.Platform.CoreMidi/Bluestone.Platform.CoreMidi.csproj" />
    <ProjectReference Include="../Bluestone.Platform.Windows/Bluestone.Platform.Windows.csproj" />
    <ProjectReference Include="../Bluestone.Playback/Bluestone.Playback.csproj" />
    <ProjectReference Include="../Bluestone.Plugins/Bluestone.Plugins.csproj" />
    <!-- The plugin pipeline probe launches real plugin workers; the worker is copied beside the probes, never loaded. -->
    <ProjectReference Include="../Bluestone.PluginWorker/Bluestone.PluginWorker.csproj" ReferenceOutputAssembly="false" OutputItemType="Content" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../Bluestone.Profiles/Bluestone.Profiles.csproj" />
    <!-- The engine probes start the engine; its JIT build is copied beside the probes as a fallback to the NativeAOT one. -->
    <ProjectReference Include="../Bluestone.Engine/Bluestone.Engine.csproj" ReferenceOutputAssembly="false" OutputItemType="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
