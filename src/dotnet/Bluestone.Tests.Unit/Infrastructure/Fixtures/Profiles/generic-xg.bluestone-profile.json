{
  "format": "bluestone-device-profile",
  "schemaVersion": 1,
  "id": "bluestone.generic.xg",
  "version": "1.0.0",
  "name": "Generic XG",
  "description": "Instruments compatible with the XG format: bank select layout, XG System On, and XG parameter change messages. Voice names are intentionally not included; programs are shown by number.",
  "notices": [
    "Bluestone is an independent project and is not affiliated with, authorized, sponsored, or endorsed by Yamaha Corporation. Yamaha and XG belong to their respective owners and are used only to describe compatibility with the XG format."
  ],
  "provenance": {
    "sources": [
      "Publicly documented XG format conventions: bank select assignments (MSB 0 normal voices, 64 SFX voices, 126 SFX kits, 127 drum kits), the XG System On message, the XG parameter change message layout, and the recommended delay after System On.",
      "MIDI 1.0 Detailed Specification: controller numbers, registered parameters, and universal System Exclusive formats.",
      "XG format documentation: the XG NRPN list (MSB 01: vibrato, filter, and EG offsets, data entry 40H = no change) and the multi part parameter change addresses (08 nn xx, part nn), used for the parameter map."
    ],
    "contributors": [
      "Bluestone contributors"
    ],
    "license": "MIT",
    "redistributionConfirmed": true,
    "verification": "unverified",
    "notes": "Contains only interface facts needed to address an XG instrument, no voice lists or other vendor text. The parameter map follows the XG documentation. Not yet checked against hardware."
  },
